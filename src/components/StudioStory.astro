---
const videos=['-GAL0bwkA48','Mxc9KpGzo0o','A0VYdiuwzH8','9UWiOtjQo0E'];
---
<section class="studio-story"><div class="story-founder"><img src="/images/salomatina/founder.webp" width="1000" height="1500" loading="lazy" alt="Алина Саломатина — основатель Alina Salomatina Interiors"/><div><span class="micro accent">ЛЮДИ ЗА ВАШИМ ИНТЕРЬЕРОМ</span><h2>Алина Саломатина</h2><p class="story-lead">Основатель Alina Salomatina Interiors</p><p>Создаём интерьеры, в которых красиво жить. И легко быть собой.</p><a href="#studio-team">Познакомиться с командой ↓</a></div></div><figure id="studio-team" class="story-team"><img src="/images/salomatina/team.webp" width="1600" height="1067" loading="lazy" alt="Команда студии Alina Salomatina Interiors"/><figcaption>Команда Alina Salomatina Interiors</figcaption></figure></section>
<section class="studio-story"><span class="micro accent">ОТ ЗАМЫСЛА К РЕЗУЛЬТАТУ</span><h2>Задумано. Воплощено.</h2><p>Визуализация и фотография готового интерьера. Один интерьер, разные ракурсы.</p><div class="comparison" style="--split:50%"><img src="/images/salomatina/comparison-photo.webp" width="1400" height="933" loading="lazy" alt="Готовый интерьер с деревянной перегородкой и терракотовыми светильниками"/><img class="comparison-render" src="/images/salomatina/comparison-render.webp" width="1400" height="933" loading="lazy" alt="Визуализация проекта гостиной и кухни"/><span class="compare-label before">Визуализация</span><span class="compare-label after">Реальное фото</span><span class="compare-line" aria-hidden="true"></span></div><label class="compare-control">Сравнить проект и реализацию<input type="range" min="0" max="100" value="50" id="project-comparison" aria-label="Положение разделителя визуализации и фотографии"/></label><p class="r-note">Двигайте ползунок или используйте стрелки на клавиатуре. <a href="https://salomatina.design/#" target="_blank" rel="noopener noreferrer">Материалы с сайта студии ↗</a></p></section>
<section class="studio-story"><span class="micro accent">МЕСТО, ГДЕ РОЖДАЮТСЯ ПРОЕКТЫ</span><h2>Офис в Москве</h2><div class="office-photos">{[1,2,3].map(n=><img src={`/images/salomatina/office-${n}.webp`} width="1000" height="1500" loading="lazy" alt={`Московский офис Alina Salomatina Interiors — вид ${n}`}/>)}</div></section>
<section class="studio-story"><span class="micro accent">СТУДИЯ В КАДРЕ</span><h2>Посмотрите ближе</h2><div class="studio-videos">{videos.map((id,i)=><article><div class="video-player"><button type="button" class="video-load" data-video={id} aria-label={`Воспроизвести видео студии ${i+1}`}><img src={`https://i.ytimg.com/vi/${id}/hqdefault.jpg`} width="480" height="360" loading="lazy" alt={`Видео Alina Salomatina Interiors ${i+1}`}/><span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 5 11 7-11 7Z" fill="currentColor"/></svg>Смотреть видео</span></button></div><a href={`https://www.youtube.com/watch?v=${id}`} target="_blank" rel="noopener noreferrer">Открыть на YouTube ↗</a></article>)}</div></section>
<style>
.studio-story{padding-block:60px;border-top:1px solid #354052}.studio-story h2{font-size:clamp(32px,4vw,60px);line-height:1.1;letter-spacing:-1.7px;margin:22px 0}.studio-story p{font-size:20px;line-height:1.6;color:#c5cddd;max-width:780px}.studio-story a{color:#a6bfff}.story-founder{display:grid;grid-template-columns:1fr 1.2fr;gap:clamp(24px,5vw,80px);align-items:center}.story-founder img{width:100%;height:auto;max-height:680px;object-fit:cover;border-radius:22px}.story-team{margin:60px 0 0}.story-team img{width:100%;height:auto;border-radius:22px}.story-team figcaption{padding-top:16px;color:#c5cddd}.office-photos{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}.office-photos img{width:100%;height:auto;aspect-ratio:2/3;object-fit:cover;border-radius:18px}.comparison{position:relative;aspect-ratio:3/2;overflow:hidden;border-radius:22px;margin-top:30px}.comparison>img{width:100%;height:100%;object-fit:cover;display:block}.comparison-render{position:absolute;inset:0;clip-path:inset(0 calc(100% - var(--split)) 0 0)}.compare-line{position:absolute;top:0;bottom:0;left:var(--split);width:2px;background:white}.compare-label{position:absolute;top:20px;background:#111b;padding:10px 16px;border-radius:30px;color:white}.before{left:20px}.after{right:20px}.compare-control{display:grid;gap:14px;margin-top:22px;font-size:18px}.compare-control input{width:100%;accent-color:#a6bfff;min-height:44px}.studio-videos{display:grid;grid-template-columns:1fr 1fr;gap:32px}.video-player{aspect-ratio:16/9;background:#080d16;border-radius:18px;overflow:hidden;margin-bottom:14px}.video-load{position:relative;width:100%;height:100%;padding:0;border:0;cursor:pointer;background:#080d16;color:white}.video-load img{width:100%;height:100%;object-fit:cover;opacity:.75}.video-load span{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);display:flex;align-items:center;gap:10px;background:#101725e8;padding:12px 18px;border-radius:40px;white-space:nowrap;font-size:17px}.video-load svg{width:28px;height:28px}.video-player :global(iframe){width:100%;height:100%;border:0}@media(max-width:650px){.story-founder,.studio-videos{grid-template-columns:1fr}.office-photos{gap:10px;grid-template-columns:1fr 1fr}.office-photos img:last-child{grid-column:1/-1;aspect-ratio:3/2}.studio-story{padding-block:40px}.compare-label{font-size:12px;padding:7px 10px;top:10px}.before{left:10px}.after{right:10px}}
</style>
<script>
document.querySelector<HTMLInputElement>('#project-comparison')?.addEventListener('input',e=>{document.querySelector<HTMLElement>('.comparison')!.style.setProperty('--split',(e.target as HTMLInputElement).value+'%');});
document.querySelectorAll<HTMLButtonElement>('[data-video]').forEach(button=>button.addEventListener('click',()=>{const frame=document.createElement('iframe');frame.src=`https://www.youtube-nocookie.com/embed/${button.dataset.video}?autoplay=1`;frame.title='Видео Alina Salomatina Interiors';frame.allow='autoplay; encrypted-media; picture-in-picture; fullscreen';frame.allowFullscreen=true;button.replaceWith(frame);}));
</script>
