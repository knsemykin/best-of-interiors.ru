---
import '@fontsource-variable/manrope';
import '../styles/global.css';
import '../styles/ranking.css';
import ArchitectureCard from './ArchitectureCard.astro';
import RankingInteractions from './RankingInteractions.astro';
import ProjectCredit from './ProjectCredit.astro';
import Metrika from './Metrika.astro';
import {indexable} from '../data/site';
import {architectureSections,bureauList,criteriaNames,criteriaExplanations,weights,products} from '../data/architecture';
const {section}=Astro.props;
const bureaus=bureauList(section.segment),w=weights[section.segment as keyof typeof weights];
const title=`ТОП-${bureaus.length}: ${section.title.toLowerCase()} Москвы и МО — рейтинг 2026`;
const canonical='https://best-of-interiors.ru'+section.url;
const schema={'@context':'https://schema.org','@graph':[{'@type':'CollectionPage',name:title,description:section.description,url:canonical,dateModified:'2026-10-09',inLanguage:'ru-RU',author:{'@type':'Organization',name:'Редакция Best of Interiors',url:'https://best-of-interiors.ru/'}},{'@type':'BreadcrumbList',itemListElement:[['Главная','/'],['Архитектурные бюро','/ratings/arhitekturnye-byuro/'],[section.short,section.url]].map(([name,path],i)=>({'@type':'ListItem',position:i+1,name,item:'https://best-of-interiors.ru'+path}))},{'@type':'ItemList',name:section.title,numberOfItems:bureaus.length,itemListElement:bureaus.map((b,i)=>({'@type':'ListItem',position:i+1,name:b.name,url:canonical+'#'+b.bureau_id}))}]};
---
<!doctype html><html lang="ru"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>{title} | Best of Interiors</title><meta name="description" content={section.description}/><meta name="robots" content={indexable?'index, follow, max-image-preview:large':'noindex, follow'}/><link rel="canonical" href={canonical}/><link rel="icon" href="/favicon.svg"/><meta name="theme-color" content="#101112"/><meta name="format-detection" content="telephone=no,email=no,address=no"/><meta property="og:title" content={title}/><meta property="og:description" content={section.description}/><meta property="og:url" content={canonical}/><meta property="og:type" content="website"/><meta property="og:image" content="https://best-of-interiors.ru/images/architecture-model-1200.webp"/><script type="application/ld+json" set:html={JSON.stringify(schema)}/></head><body class="ranking-page" data-directory="architecture"><a class="skip" href="#main">Перейти к содержимому</a><header class="header wrap"><a class="brand" href="/">best of<span>interiors<i>✳</i></span></a><nav><a href="#rating">Рейтинг ↗</a><a href="#methodology">Методика</a><a href="#guide">Как выбрать</a></nav><button class="header-cta" data-quiz>Описать задачу ↗</button></header><main id="main">
<section class="rank-hero wrap"><img class="rank-art" src="/images/architecture-model-1800.webp" srcset="/images/architecture-model-640.webp 640w, /images/architecture-model-1200.webp 1200w, /images/architecture-model-1800.webp 1800w" sizes="100vw" width="1536" height="1024" fetchpriority="high" alt=""/><nav class="breadcrumbs"><a href="/">Главная</a><span>/</span><a href="/ratings/arhitekturnye-byuro/">Архитектурные бюро</a><span>/</span><span>{section.short}</span></nav><div class="hero-edition"><span class="micro">МОСКВА И МО / {section.short.toUpperCase()}</span><span class="micro">ОКТЯБРЬ / 2026</span></div><h1>ТОП-{bureaus.length} архитектурных бюро <em>{section.slug==='chastnye-doma'?'для частных домов':section.slug==='development'?'для девелопмента':'для городской среды'}</em> <span class="h1-edition">Москва и МО · рейтинг 2026</span></h1><p class="rank-hero-intro">{section.intro}</p><p class="rank-hero-copy">{section.description}</p><div class="hero-links"><button class="r-button" data-quiz>Один бриф — предложения под задачу ↗</button></div><button class="rank-motion" aria-label="Приостановить анимацию" aria-pressed="false">Ⅱ</button><div class="hero-data"><span><b>{bureaus.length}</b> компаний</span><span><b>10</b> критериев</span><a href="#editorial">Данные на 09.10.2026 ↗</a></div></section>
<nav class="city-nav wrap" aria-label="Направление архитектуры"><a href="/ratings/arhitekturnye-byuro/">Все направления ↗</a>{architectureSections.map(s=><a href={s.url} aria-current={s.slug===section.slug?'page':undefined}>{s.short} · {s.count}</a>)}<a href="/ratings/dizayn-interera/moskva/">Дизайн интерьера Москвы</a></nav>
<section class="rank-section wrap promo-invitation"><span class="micro accent">ПАРТНЁРАМ ПРОЕКТА</span><h2>Ваш подход заслуживает внимания.</h2><p>Познакомьте будущих заказчиков с командой и проектами в формате ПРОМО.</p><a class="r-secondary" href="/partners/">Обсудить сотрудничество ↗</a></section>
<section id="rating" class="rank-section wrap"><div class="rank-section-head"><div><span class="micro accent">ВЫБОР ПОД ВАШ МАСШТАБ</span><h2>Найдите <em>своё бюро.</em></h2></div><p>Рейтинг раскрытых компетенций и сведений.<br/>По методике проекта.</p></div><div class="directory-layout"><aside class="filters"><form id="filters" role="search"><h3>Ваши ориентиры</h3><label>Поиск<input type="search" id="search" placeholder="Бюро, тип организации, проект, стиль"/></label><select id="segment" hidden aria-label="Сегмент"><option value="all">Все</option><option value="architecture">Архитектура</option></select><label>Расположение<select id="office"><option value="all">Все основания включения</option><option value="local">Опубликован адрес офиса</option><option value="other">Адрес уточняется</option></select></label><label>Продукт для сравнения цены<select id="price-product">{products.map(([key,,name])=><option value={key} selected={key==='rd'}>{name}</option>)}</select></label><label>Стоимость выбранного продукта<select id="budget"><option value="all">Любой бюджет</option><option value="known">Есть ставка в ₽/м²</option><option value="unknown">Стоимость по запросу</option><option value="3000">До 3 000 ₽/м²</option><option value="5000">До 5 000 ₽/м²</option><option value="10000">До 10 000 ₽/м²</option></select></label><fieldset><legend>Компетенции</legend><label class="check"><input id="supervision" type="checkbox"/>Авторское сопровождение</label><label class="check"><input id="procurement" type="checkbox"/>Комплектация</label><label class="check"><input id="renovation" type="checkbox"/>Строительный подряд</label>{[['documentation','Рабочая документация'],['structural','Конструктив'],['engineering','Инженерия'],['bim','BIM / ТИМ']].map(([key,name])=><label class="check"><input type="checkbox" data-competency={key}/>{name}</label>)}</fieldset><p class="r-note">Сравнивайте одинаковые разделы и состав. Отсутствие цены не означает отсутствие услуги.</p><button type="reset" class="reset-filters">Сбросить фильтры ↺</button></form></aside><div class="directory"><div class="directory-toolbar"><p id="result-count" role="status">{bureaus.length} компаний</p><label>Порядок<select id="sort"><option value="score">По индексу сведений</option><option value="price">По цене выбранного продукта</option><option value="name">По названию</option></select></label></div><p class="directory-note">Сведения на 9 октября 2026. Баллы отражают опубликованные компетенции; выбирайте команду по задаче, составу работ и условиям сотрудничества.</p><noscript>Все компании доступны без JavaScript; фильтры, сравнение и формы требуют его включения.</noscript><div id="studio-list">{bureaus.map(b=><ArchitectureCard bureau={b} weights={w}/>)}</div><div id="empty-state" class="empty-state" hidden><h3>Расширим поиск?</h3><p>Измените продукт или снимите часть фильтров.</p><button class="r-button" id="empty-reset">Сбросить фильтры</button></div><div class="load-more-wrap"><p id="page-status" aria-live="polite"></p><button id="load-more" class="r-button" hidden>Показать ещё 10 компаний ↓</button></div></div></div></section>
<section id="methodology" class="rank-section method-section"><div class="wrap"><div class="rank-section-head"><div><span class="micro accent">ОТКРЫТАЯ МЕТОДИКА</span><h2>Своя задача.<br/><em>Свои критерии.</em></h2></div><p>{section.short} / Москва и МО</p></div><div class="method-intro"><p>Из общего реестра 115 организаций в этом сегменте — {bureaus.length}. Индекс рассчитывается отдельно для каждого направления. Места частных домов, девелопмента и городской среды напрямую не сравниваются.</p><p>Индекс = сумма «вес × коэффициент». Равные баллы получают равное место по методике; внутри равенства компании упорядочены по названию. Номер карточки — уникальная позиция списка.</p></div><div class="weight-grid">{criteriaNames.map((name,i)=><details><summary><span class="micro">{String(i+1).padStart(2,'0')}</span><h3>{name}</h3><b>{w[i]}<small>баллов</small></b></summary><p>{criteriaExplanations[i]} Недостаток опубликованных сведений не доказывает отсутствие компетенции.</p></details>)}</div><p class="r-note">Это рейтинг раскрытых компетенций и сведений, а не независимая оценка качества архитектуры, надёжности или строительного исполнения. Заявленное завершение даёт частичный балл; независимая проверка объектов не проводилась.</p></div></section>
<section id="guide" class="rank-section wrap guide-layout"><div><span class="micro accent">ВЫБИРАЙТЕ ОСОЗНАННО</span><h2>От задачи —<br/><em>к своей команде.</em></h2><p>{section.guide}</p><button class="r-button" data-quiz>Подготовить бриф ↗</button></div><ol class="selection-steps">{section.steps.map(([name,text],i)=><li><span>0{i+1}</span><div><h3>{name}</h3><p>{text}</p></div></li>)}</ol></section>
<section class="rank-section wrap"><h2>Вопросы перед знакомством</h2><div class="ranking-faq">{section.faq.map(([q,a])=><details><summary>{q}<span>＋</span></summary><p>{a}</p></details>)}<details><summary>Можно дополнить сведения о бюро?<span>＋</span></summary><p>Да. Нажмите «Исправить информацию» в карточке и приложите ссылки. Редакция рассмотрит обращение; новые сведения могут изменить оценку по общей методике сегмента.</p></details></div></section>
<section id="editorial" class="editorial wrap"><div><span class="micro accent">РЕДАКЦИЯ BEST OF INTERIORS</span><h3>Основания списка</h3></div><div><p>Исследование архитектурных бюро Москвы и Московской области от <time datetime="2026-10-09">9 октября 2026 года</time>. Источники — официальные сайты, профессиональные каталоги и публикации. Связь с регионом установлена по офису, филиалу или проектам; география офиса и объекта разделена в карточках.</p><p>Реестр не является исчерпывающим. Перед договором уточните актуальные контакты, команду, стоимость и роль бюро в проектах. Фотографии и иллюстрации первого экрана — оформление раздела, не портфолио участников.</p></div></section>
</main><footer class="footer wrap"><a href="/ratings/arhitekturnye-byuro/">← Все архитектурные направления</a><a href="/partners/">Для компаний</a><a href="/privacy/">Конфиденциальность</a><span>© 2026 Best of Interiors</span><ProjectCredit/></footer><RankingInteractions architecture city="Москва"/><Metrika/></body></html>
