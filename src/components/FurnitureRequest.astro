---
const {category}=Astro.props;
---
<dialog id="furniture-request" aria-labelledby="furniture-request-title" class="ym-disable-keys"><button class="dialog-close" type="button" aria-label="Закрыть форму">×</button><h2 id="furniture-request-title">Ваш проект начинается здесь.</h2><p id="furniture-recipient"></p><form id="furniture-form"><input type="hidden" name="service" value={category}/><input type="hidden" name="studio"/><label>Ваше имя<input name="name" required minlength="2" maxlength="80" autocomplete="name"/></label><label>Телефон<input name="phone" type="tel" required maxlength="25" autocomplete="tel"/></label><label>Email<input name="email" type="email" autocomplete="email"/></label><label>Что хотите заказать?<textarea name="comment" required minlength="15" maxlength="5000" rows="4" placeholder="Размеры, материалы, бюджет, адрес доставки и сроки"/></label><div hidden><input name="website" tabindex="-1" autocomplete="off"/></div><label class="furniture-consent"><input name="consent" type="checkbox" required/>Даю согласие на обработку заявки по <a href="/privacy/#consent" target="_blank">политике конфиденциальности</a>.</label><label class="furniture-consent"><input name="transferConsent" type="checkbox" required/>Согласен, что Best of Interiors сначала обработает заявку, затем передаст её выбранной мной компании для подготовки предложения. <a href="/privacy/#transfer-consent" target="_blank">Условия передачи</a>.</label><p>Отправка в почту редакции через FormSubmit.</p><p id="furniture-error" role="alert"></p><button class="r-button" type="submit">Отправить заявку ↗</button></form><div id="furniture-success" hidden tabindex="-1"><h3>Заявка принята сервисом отправки.</h3><p>Обращение направлено в почту редакции. Мы свяжемся с вами по указанным контактам.</p><p id="furniture-reference"></p></div></dialog>
<script>
import {sendSubmission} from '../scripts/form-submit';
const dialog=document.querySelector<HTMLDialogElement>('#furniture-request')!;const form=document.querySelector<HTMLFormElement>('#furniture-form')!;let sending=false;let id=crypto.randomUUID();
document.querySelectorAll<HTMLButtonElement>('[data-furniture-request]').forEach(b=>b.addEventListener('click',()=>{if(sending)return;form.reset();id=crypto.randomUUID();form.hidden=false;document.querySelector<HTMLElement>('#furniture-success')!.hidden=true;document.querySelector('#furniture-error')!.textContent='';(form.elements.namedItem('studio') as HTMLInputElement).value=b.dataset.furnitureRequest!;document.querySelector('#furniture-recipient')!.textContent='Предложение от компании '+b.dataset.furnitureRequest;dialog.showModal();}));dialog.querySelector('button')!.addEventListener('click',()=>{if(!sending)dialog.close();});dialog.addEventListener('cancel',e=>{if(sending)e.preventDefault();});
form.addEventListener('submit',async e=>{e.preventDefault();if(sending||!form.reportValidity())return;const phone=(form.elements.namedItem('phone') as HTMLInputElement).value;if(phone.replace(/\D/g,'').length<7||!/^[-+0-9()\s]+$/.test(phone)){document.querySelector('#furniture-error')!.textContent='Укажите корректный телефон.';return;}sending=true;const b=form.querySelector<HTMLButtonElement>('[type=submit]')!;b.disabled=true;document.querySelector('#furniture-error')!.textContent='';try{const d=Object.fromEntries(new FormData(form));await sendSubmission({...d,consent:true,transferConsent:true,page:location.pathname},'Best of Interiors — заявка: '+String(d.service),id);form.hidden=true;const success=document.querySelector<HTMLElement>('#furniture-success')!;success.hidden=false;success.focus();document.querySelector('#furniture-reference')!.textContent='Номер заявки: '+id.slice(0,8);}catch{document.querySelector('#furniture-error')!.textContent='Отправка не подтверждена. Попробуйте ещё раз или напишите hello@best-of-interiors.ru.';}finally{sending=false;b.disabled=false;}});
</script>
<style>#furniture-request{max-height:90dvh;overflow:auto}label{display:grid;gap:8px;margin:18px 0}input,textarea{width:100%}.furniture-consent{display:block;font-size:14px;line-height:1.6}.furniture-consent input{display:inline;width:18px;height:18px;margin-right:8px}.furniture-consent a{text-decoration:underline;color:#a6bfff}form>p{font-size:14px}#furniture-error{color:#ffb5b5}</style>
