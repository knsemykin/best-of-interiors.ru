---
import '@fontsource-variable/manrope';import '../styles/global.css';import '../styles/ranking.css';
import SiteHeader from './SiteHeader.astro';import PartnerInvitation from './PartnerInvitation.astro';import LegalNotice from './LegalNotice.astro';import ProjectCredit from './ProjectCredit.astro';import Metrika from './Metrika.astro';import EditorialDialog from './EditorialDialog.astro';import FurnitureRequest from './FurnitureRequest.astro';
import {windowDirections,windowCompanies,windowWaitlist,windowCriteria,windowWeights,windowRubrics,excludedWindows} from '../data/windows-moscow';import {indexable} from '../data/site';
const {page}=Astro.props;const companies=windowCompanies(page.code);const waiting=windowWaitlist(page.code);const canonical='https://best-of-interiors.ru'+page.url;
const title=`${page.name} в Москве и МО — ТОП-${companies.length}, рейтинг 2026 | Best of Interiors`;
const description=`${page.h1}: ${companies.length} компаний. Сравните производство, профильные системы, гарантии и баллы. Таблица, методика, источники и запрос предложения.`;
const number=(n:number)=>n.toLocaleString('ru-RU',{minimumFractionDigits:1,maximumFractionDigits:1});
const profiles=c=>(page.code==='pvc'?c.pvc:page.code==='balc'?[...(c.pvc||[]),...(c.alu||[])]:c.alu)?.join(', ')||'Нет данных';
const warranty=c=>c.warranty==='5/5'?'Изделие — 5 лет; монтаж — 5 лет':c.warranty==='5/2'?'Изделие — 5 лет; монтаж — 2 года':c.warranty==='3/1'?'Изделие — 3 года; монтаж — 1 год':c.warranty||'Нет данных';
const schema={'@context':'https://schema.org','@graph':[{'@type':'CollectionPage',name:title,description,url:canonical,dateModified:'2026-10-12',inLanguage:'ru-RU',author:{'@type':'Organization',name:'Редакция Best of Interiors'},mainEntity:{'@type':'ItemList',numberOfItems:companies.length,itemListElement:companies.map(c=>({'@type':'ListItem',position:c.position,url:canonical+'#'+c.id,name:c.name}))}},{'@type':'BreadcrumbList',itemListElement:[['Главная','/'],['Окна','/ratings/okna/'],['Москва и МО','/ratings/okna/moskva/'],[page.name,page.url]].map(([name,url],i)=>({'@type':'ListItem',position:i+1,name,item:'https://best-of-interiors.ru'+url}))}]};
---
<!doctype html><html lang="ru"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>{title}</title><meta name="description" content={description}/><meta name="robots" content={indexable?'index,follow,max-image-preview:large':'noindex,follow'}/><link rel="canonical" href={canonical}/><link rel="icon" href="/favicon.svg"/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/><meta property="og:type" content="website"/><meta property="og:image" content="https://best-of-interiors.ru/images/windows-garden-1200.webp"/><script type="application/ld+json" set:html={JSON.stringify(schema)}/></head><body class="ranking-page"><a class="skip" href="#main">Перейти к содержимому</a><SiteHeader links={[{href:'#rating',label:'Рейтинг'},{href:'#comparison',label:'Сравнение'},{href:'#methodology',label:'Методика'}]}/><main id="main">
<section class="wrap mw-hero"><nav class="breadcrumbs"><a href="/">Главная</a> / <a href="/ratings/okna/">Окна</a> / <a href="/ratings/okna/moskva/">Москва и МО</a></nav><span class="micro accent">МОСКВА И ПОДМОСКОВЬЕ / РЕЙТИНГ 2026</span><h1>{page.h1}</h1><p>{page.intro}</p><div class="mw-meta"><span>ТОП-{companies.length} компаний</span><span>Редакция Best of Interiors · 12 октября 2026</span></div><a class="r-button" href="#comparison">Сравнить компании ↓</a><a class="partner-telegram" href="#rating">Перейти к карточкам ↓</a></section>
<section id="methodology" class="wrap mw-section"><span class="micro accent">КАК МЫ СЧИТАЛИ</span><h2>Семь критериев.<br/><em>Открытый расчёт.</em></h2><p>Балл от 0 до 10 рассчитывается по методике предоставленного исследования: сумма оценок по критериям, умноженных на их веса, с округлением до десятых. При отсутствии сведений в методике предусмотрена нейтральная оценка 5. Порядок при равных итоговых баллах сохранён из исследования.</p><div class="mw-criteria">{windowCriteria.map((c,i)=><details><summary>{c} <b>{Math.round(windowWeights[i]*100)}%</b></summary><p>{windowRubrics[i]}</p></details>)}</div><p class="r-note">Репутационный критерий основан на сводной базе oknarating.ru, указанной в исследовании: обновление 3 мая 2026 года. Это не текущий рейтинг Яндекс Карт или 2ГИС. Свежая независимая сверка всех карточек не выполнена. Рекламные позиции агрегатора не перенесены в порядок этого списка.</p></section>
<section class="wrap mw-partners"><span class="micro accent">ПАРТНЁРАМ ПРОЕКТА</span><h2>Расскажите о компании <em>тем, кто выбирает.</em></h2><a class="r-button" href="/partners/">ПРОМО-размещение и тарифы ↗</a><a class="partner-telegram" href="https://t.me/knsemykin" target="_blank" rel="noopener noreferrer">Обсудить в Telegram ↗</a></section>
<section id="comparison" class="wrap mw-section"><h2>Сравнение <em>по существу.</em></h2><p class="r-note">На телефоне таблицу можно прокрутить по горизонтали. Нажмите название, чтобы перейти к подробной карточке.</p><div class="mw-table" role="region" aria-label="Сравнение оконных компаний" tabindex="0"><table><caption>{page.name} — Москва и МО, 2026</caption><thead><tr><th scope="col">Место / компания</th><th scope="col">Балл</th><th scope="col">Производство</th><th scope="col">Профильные системы</th><th scope="col">Гарантия</th></tr></thead><tbody>{companies.map(c=><tr><th scope="row"><a href={'#'+c.id}>{c.position}. {c.name}</a>{c.group&&<small>Одна группа: {c.group}</small>}</th><td>{number(c.score!)}/10</td><td>{c.prod||'Нет данных'}</td><td>{profiles(c)}</td><td>{warranty(c)}</td></tr>)}</tbody></table></div></section>
<section id="rating" class="wrap mw-section"><span class="micro accent">ПОДРОБНО О КОМПАНИЯХ</span><h2>Кто займётся <em>вашими окнами.</em></h2><form id="mw-filters"><label>Найти компанию или профиль<input type="search" name="search" placeholder="Например, VEKA или Домком"/></label><label>Группа компаний<select name="group"><option value="">Все участники</option><option value="ECOOKNA GROUP">ECOOKNA GROUP</option><option value="other">Остальные участники</option></select></label><button type="reset" class="r-secondary">Сбросить</button></form><p id="mw-count" role="status">Найдено: {companies.length}</p>{companies.map(c=><article class="studio-card mw-card" id={c.id} data-mw-card data-search={[c.name,profiles(c),c.prod].join(' ').toLowerCase()} data-group={c.group||''}><div class="studio-main"><div class="studio-heading"><span class="rank-number">{String(c.position).padStart(2,'0')}</span><div><span class="micro">{page.name} · Москва и МО</span><h3>{c.name}</h3>{c.group&&<span class="mw-group">Одна группа компаний · {c.group}</span>}</div></div><p class="studio-description">{c.name} входит в подборку «{page.name.toLowerCase()}» по материалам исследования. {c.since&&`Бренд работает с ${c.since} года.`} {c.prod&&`Производственная площадка по собранным сведениям: ${c.prod}.`}</p><dl class="studio-facts"><div><dt>Профильные системы</dt><dd>{profiles(c)}</dd></div><div><dt>Гарантия</dt><dd>{warranty(c)}</dd></div><div><dt>Телефон</dt><dd>{c.phone||'Нет данных'}</dd></div><div><dt>ИНН</dt><dd>{c.inn||'Нет данных'}</dd></div></dl><div class="mw-fit"><p><b>Плюсы по материалам:</b> {c.prod?'указана производственная площадка; ':''}{profiles(c)!=='Нет данных'?'раскрыты профильные системы.':'есть оценка по общей методике исследования.'}</p><p><b>Что уточнить:</b> {c.inn?'юридическое лицо в договоре, актуальную комплектацию и состав монтажа.':'реквизиты исполнителя, производство и условия договора.'}</p><p><b>Кому подходит:</b> тем, кто сравнивает предложения по направлению «{page.name.toLowerCase()}» в Москве и Подмосковье.</p></div></div><aside class="studio-action"><a class="index-score" href="#methodology"><strong>{number(c.score!)}</strong><span>/ 10<br/>балл исследования</span></a><p>По методике проекта</p><button class="r-button" data-furniture-request={c.name}>Получить предложение ↗</button>{c.site&&(c.position<=10?<a class="studio-website" href={c.site} target="_blank" rel="noopener noreferrer">{c.site.replace(/^https?:\/\//,'')} ↗</a>:<span class="studio-website">{c.site.replace(/^https?:\/\//,'')}</span>)}</aside><details class="studio-details"><summary>Расчёт балла, реквизиты и источники <span>＋</span></summary><div class="mw-table"><table><caption>Расчёт балла {c.name}</caption><thead><tr><th>Критерий</th><th>Оценка / 10</th><th>Вес</th><th>Вклад</th></tr></thead><tbody>{c.s!.map((s,i)=><tr><th>{windowCriteria[i]}</th><td>{number(s)}</td><td>{Math.round(windowWeights[i]*100)}%</td><td>{(s*windowWeights[i]).toLocaleString('ru-RU',{maximumFractionDigits:3})}</td></tr>)}</tbody></table></div>{c.ogrn&&<p>ОГРН: {c.ogrn}</p>}{c.reg&&<p>Регистрация юрлица: {c.reg}. История бренда и возраст юрлица могут различаться.</p>}{c.ok&&<p>Сводный индекс oknarating.ru в исходном исследовании: {number(c.ok[0])}/10, объём базы по компании — {c.ok[1]} отзывов. Не является оценкой Яндекс Карт.</p>}<p>Источники исследования:</p><div class="mw-sources">{[...new Set([c.site,...c.src].filter(Boolean))].map((url,i)=><a href={url!} target="_blank" rel="noopener noreferrer">{new URL(url!).hostname} · {i+1} ↗</a>)}</div></details><button class="mw-correction" data-correction={c.id} data-company={c.name}>Это ваша компания? Исправить информацию ↗</button></article>)}<p id="mw-empty" hidden>Компании не найдены. Попробуйте другой запрос или сбросьте фильтры.</p></section>
{waiting.length>0&&<section class="wrap mw-section"><span class="micro accent">ЛИСТ ОЖИДАНИЯ / БЕЗ МЕСТ И БАЛЛОВ</span><h2>Другие компании <em>направления.</em></h2><p>В исходном исследовании эти компании оставлены для дополнительной проверки. Отсутствие балла не означает низкое качество работ.</p><div class="mw-wait">{waiting.map(c=><article><h3>{c.name}</h3><p>{c.prod||'Сведения требуют дополнения.'}</p><p>ИНН: {c.inn||'Нет данных'}</p>{c.site&&<span>{c.site}</span>}</article>)}</div></section>}
<section class="wrap mw-section"><h2>Перед заказом.</h2><p>{page.guide}</p><h3 class="mw-subtitle">Частые вопросы</h3>{page.faq.map(([q,a])=><details class="mw-faq"><summary>{q}<span>＋</span></summary><p>{a}</p></details>)}<details class="mw-faq"><summary>Как учитывать компании одной группы?<span>＋</span></summary><p>Экоокна, Окна Роста, Евроокна и Kaleva помечены в исследовании как ECOOKNA GROUP. Бренды показаны отдельно, но при сборе предложений учитывайте эту связь.</p></details><details class="mw-faq"><summary>Какие компании не включены?<span>＋</span></summary><p>{excludedWindows.map(c=>c.name).join(', ')} не включены в рейтинги по решению исходного исследования. Сведения для сопоставимого участия не собраны; оценка качества их услуг на этой странице не выставляется.</p></details><p class="r-note">Материалы исследования от 12.10.2026. Платные размещения отделяются пометкой ПРОМО. Балл не гарантирует качество конкретного заказа. Цены и условия подтвердите у исполнителя до заключения договора.</p></section>
<section class="wrap mw-section"><h2>Другие направления <em>Москвы и МО.</em></h2><nav class="mw-links" aria-label="Рейтинги остекления">{windowDirections.filter(p=>p.code!==page.code).map(p=><a href={p.url}>{p.name}<span>{windowCompanies(p.code).length} компаний ↗</span></a>)}<a href="/ratings/okna/moskva/">Все оконные направления<span>Москва и МО ↗</span></a><a href="/ratings/okna/voronezh/">Оконные компании Воронежа<span>Другой город ↗</span></a><a href="/ratings/mebel/">Мебельные компании<span>Москва и МО ↗</span></a></nav></section>
</main><footer class="footer wrap"><PartnerInvitation/><LegalNotice/><ProjectCredit/></footer><FurnitureRequest category={page.name}/><EditorialDialog/><Metrika/>
<script>
const form=document.querySelector<HTMLFormElement>('#mw-filters')!;const cards=[...document.querySelectorAll<HTMLElement>('[data-mw-card]')];function update(){const d=new FormData(form),q=String(d.get('search')||'').trim().toLowerCase(),g=d.get('group');let n=0;cards.forEach(c=>{c.hidden=!(c.dataset.search!.includes(q)&&(!g||(g==='other'?!c.dataset.group:c.dataset.group===g)));if(!c.hidden)n++;});document.querySelector('#mw-count')!.textContent=`Найдено: ${n} из ${cards.length}`;document.querySelector<HTMLElement>('#mw-empty')!.hidden=n!==0;}form.addEventListener('input',update);form.addEventListener('change',update);form.addEventListener('reset',()=>queueMicrotask(update));
</script>
<style>
.mw-hero{padding-block:32px 65px}.mw-hero h1{font-size:clamp(38px,5.8vw,84px);line-height:1.08;letter-spacing:-.045em;margin:30px 0}.mw-hero>p,.mw-section>p{max-width:1050px;font-size:20px}.mw-meta{display:flex;flex-wrap:wrap;gap:24px;color:#b7c5df;font-size:15px;margin:28px 0}.mw-section{padding-block:55px}.mw-section h2{margin-bottom:30px}.mw-section em,.mw-partners em{font-family:Georgia,serif;font-weight:400;color:#a6bfff}.mw-criteria{display:grid;grid-template-columns:repeat(2,1fr);gap:14px;margin:28px 0}.mw-criteria details{padding:0 20px;border:1px solid #465574;border-radius:12px}.mw-criteria summary{font-size:17px}.mw-criteria p{font-size:16px;padding-bottom:20px}.mw-partners{padding:35px;background:linear-gradient(120deg,#263348,#28202d);border:1px solid #4c5f7e;border-radius:22px}.mw-partners h2{font-size:clamp(28px,4vw,46px);margin:20px 0}.mw-table{overflow-x:auto;border:1px solid #3e4c62;border-radius:16px;margin:22px 0}.mw-table table{width:100%;border-collapse:collapse;min-width:740px;font-size:16px}.mw-table caption{text-align:left;padding:18px;color:#c7d7f5}.mw-table th,.mw-table td{padding:18px;text-align:left;vertical-align:top;border-top:1px solid #374357;min-width:120px}.mw-table thead{background:#202a3a}.mw-table th a{color:#adc5ff}.mw-table small{display:block;font-size:12px;font-weight:400;margin-top:8px}.mw-card{margin-bottom:24px}.mw-group{display:inline-block;font-size:13px;background:#263852;border:1px solid #52729f;border-radius:20px;padding:6px 12px;margin-top:12px}.mw-fit{padding:20px;background:#202633;border-radius:14px;margin-top:24px}.mw-fit p{font-size:16px;margin-bottom:10px}.mw-correction{grid-column:1/-1;padding:20px;background:none;border-top:1px solid #3b4556;color:#adc1ff;text-align:left;font-size:16px}.mw-sources{display:flex;gap:20px;flex-wrap:wrap;margin:20px 0;color:#adc1ff}.mw-wait,.mw-links{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin:25px 0}.mw-wait article,.mw-links a{padding:24px;border:1px solid #405170;border-radius:14px;background:#1b2330}.mw-wait p{font-size:16px;margin-top:15px}.mw-wait span{font-size:14px;overflow-wrap:anywhere}.mw-links a{font-size:21px}.mw-links span{display:block;color:#adc1ff;font-size:14px;margin-top:15px}#mw-filters{display:grid;grid-template-columns:2fr 1fr auto;gap:18px;padding:24px;background:#1b2330;border-radius:16px;align-items:end;margin:25px 0}#mw-count{margin-bottom:20px}.mw-faq{border-bottom:1px solid #39465c}.mw-faq p{padding-bottom:25px;font-size:18px}.mw-subtitle{font-size:30px;margin:45px 0 15px}@media(max-width:760px){.mw-criteria,.mw-wait,.mw-links,#mw-filters{grid-template-columns:1fr}.mw-hero>p,.mw-section>p{font-size:18px}.mw-section{padding-block:40px}.mw-partners{padding:25px}}
</style></body></html>
