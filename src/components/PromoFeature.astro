---
import {price} from '../data/moscow';
const {portfolio:p,studio:s,index}=Astro.props;
const copy=[['Интерьер, в котором узнаёте себя.','От первой идеи до готового дома. Индивидуальная стилистика, авторское сопровождение и комплектация под вашу задачу.'],['Ваше пространство. Ваш характер.','Выразительные интерьеры и архитектура. Познакомьтесь с работами бюро и обсудите свой проект с командой.'],['От архитектуры до ощущения дома.','Nature, Accent и VIP — три авторских направления бюро. Дизайн, архитектура и сопровождение реализации.']][index];
---
<article class={`featured featured-${index}`}><div class="featured-body"><div class="promo-heading"><span class="promo-badge">ПРОМО</span><span class="micro">0{index+1} / ОСОБОЕ ЗНАКОМСТВО</span></div><h3 class="featured-name"><a href={`/companies/${p.slug}/`}>{p.name}</a></h3><div class="promo-highlight"><img src="/images/promo-rosette.webp" width="160" height="160" loading="lazy" alt=""/><div><strong>{p.highlight}</strong><span>{p.highlightNote}</span></div></div><h4>{copy[0]}</h4><p>{copy[1]}</p><div class="featured-bottom"><span>{price(s)}</span><button class="r-button" data-lead={s.studio_id}>Получить персональное предложение ↗</button></div></div><div class="promo-portfolio" data-gallery aria-label={`Портфолио ${p.name}`} aria-roledescription="карусель"><div class="portfolio-stage">{p.works.slice(0,3).map((w,i)=><figure class="portfolio-slide" hidden={i>0}><a href={`/companies/${p.slug}/`} aria-label={`Открыть портфолио ${p.name}: ${w.title}`}><img src={w.image} width="1200" height="800" loading="lazy" alt={`${w.title} — из портфолио ${p.name}`}/></a><figcaption><span>{w.title}</span><a href={w.source} target="_blank" rel="noopener noreferrer">Источник: {p.name} ↗</a></figcaption></figure>)}<span class="portfolio-label">ПОРТФОЛИО СТУДИИ</span></div><div class="portfolio-controls"><button data-gallery-prev aria-label={`Предыдущая работа ${p.name}`}>←</button><span data-gallery-count aria-live="polite">01 / 03</span><button data-gallery-next aria-label={`Следующая работа ${p.name}`}>→</button><a href={`/companies/${p.slug}/`}>Все проекты в карточке ↗</a></div></div></article>
