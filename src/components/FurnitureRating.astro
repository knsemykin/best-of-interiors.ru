---
import '@fontsource-variable/manrope';
import '../styles/global.css';import '../styles/ranking.css';
import SiteHeader from './SiteHeader.astro';import PartnerInvitation from './PartnerInvitation.astro';import LegalNotice from './LegalNotice.astro';import ProjectCredit from './ProjectCredit.astro';import Metrika from './Metrika.astro';import EditorialDialog from './EditorialDialog.astro';import FurnitureRequest from './FurnitureRequest.astro';
import {entries,furniturePages,labels,criterionNames,weights} from '../data/furniture';
import {indexable} from '../data/site';
const {page}=Astro.props;const companies=entries(page);const label=labels[page.slug];const canonical='https://best-of-interiors.ru'+page.url;
const title=`${label} в Москве и МО — ТОП-${companies.length}, рейтинг 2026 | Best of Interiors`;
const types:Record<string,string>={manufacturer_declared:'Производитель',brand:'Мебельный бренд',brand_no_manufacture_disclosed:'Мебельный бренд',production_group:'Производственная группа'};
const schema={'@context':'https://schema.org','@graph':[{'@type':'CollectionPage',name:title,description:page.description,url:canonical,inLanguage:'ru-RU',dateModified:'2026-10-12',author:{'@type':'Organization',name:'Редакция Best of Interiors'},mainEntity:{'@type':'ItemList',numberOfItems:companies.length,itemListElement:companies.map(c=>({'@type':'ListItem',position:c.position,name:c.name,url:canonical+'#'+c.id}))}},{'@type':'BreadcrumbList',itemListElement:[['Главная','/'],['Мебель','/ratings/mebel/'],[label,page.url]].map(([name,url],i)=>({'@type':'ListItem',position:i+1,name,item:'https://best-of-interiors.ru'+url}))}]};
---
<!doctype html><html lang="ru"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>{title}</title><meta name="description" content={`${label} в Москве и Московской области: сравните ${companies.length} компаний, материалы, гарантии и услуги. Рейтинг 2026 с источниками и разбором баллов.`}/><meta name="robots" content={indexable?'index,follow,max-image-preview:large':'noindex,follow'}/><link rel="canonical" href={canonical}/><link rel="icon" href="/favicon.svg"/><meta property="og:title" content={title}/><meta property="og:description" content={page.description}/><meta property="og:url" content={canonical}/><meta property="og:type" content="website"/><meta property="og:image" content="https://best-of-interiors.ru/images/kitchen-640.webp"/><script type="application/ld+json" set:html={JSON.stringify(schema)}/></head><body class="ranking-page"><a class="skip" href="#main">Перейти к содержимому</a><SiteHeader links={[{href:'#rating',label:'Компании'},{href:'#guide',label:'Как выбрать'},{href:'#methodology',label:'Методика'}]}/><main id="main">
<section class="wrap furniture-hero"><nav class="breadcrumbs"><a href="/">Главная</a> / <a href="/ratings/mebel/">Мебель</a> / Москва и МО</nav><span class="micro accent">ВЫБИРАЕМ ДЛЯ ЖИЗНИ / МОСКВА И ОБЛАСТЬ</span><h1>ТОП-{companies.length}: {label.toLowerCase()}<br/><em>в Москве и МО.</em></h1><p class="furniture-intro">{page.intro}</p><div class="hero-meta"><span>Рейтинг 2026</span><span>Редакция Best of Interiors · 12.10.2026</span></div><a class="r-button" href="#rating">Сравнить компании ↓</a><a class="r-secondary" href="/ratings/mebel/">Все мебельные направления</a></section>
<section class="wrap furniture-promo"><span class="micro accent">ПАРТНЁРАМ / ПРОМО-РАЗМЕЩЕНИЕ</span><h2>Вашей мебели <em>есть место здесь.</em></h2><p>Расскажите о производстве, материалах и проектах тем, кто уже выбирает мебель.</p><a class="r-button" href="/partners/">Сотрудничество и тарифы ↗</a><a class="partner-telegram" href="https://t.me/knsemykin" target="_blank" rel="noopener noreferrer">Обсудить в Telegram ↗</a></section>
<section id="rating" class="wrap furniture-section"><span class="micro accent">КОМПАНИИ / {companies.length} УЧАСТНИКОВ</span><h2>Детали, которые <em>важны вам.</em></h2><p class="r-note">Редакционная оценка по открытым данным. При одинаковом балле компании входят в равную группу; номер обозначает порядок карточки.</p><form id="furniture-filters" class="furniture-filters"><label>Поиск<input type="search" name="search" placeholder="Компания или материал"/></label><label>Сведения о производстве<select name="type"><option value="">Все компании</option><option value="manufacturer_declared">Заявлено производство</option><option value="brand">Мебельные бренды</option></select></label><label>Порядок<select name="sort"><option value="rating">По рейтингу</option><option value="name">По названию</option></select></label><button class="r-secondary" type="reset">Сбросить</button></form><p id="furniture-count" role="status">Найдено: {companies.length}</p><div id="furniture-list">{companies.map(c=><article class="studio-card furniture-card" id={c.id} data-company data-name={c.name} data-position={c.position} data-type={c.entity_type==='manufacturer_declared'?'manufacturer_declared':'brand'} data-search={[c.name,...c.materials_and_technologies_mentioned.map(m=>m.name)].join(' ').toLowerCase()}><div class="studio-main"><div class="studio-heading"><span class="rank-number">{String(c.position).padStart(2,'0')}</span><div><span class="micro">{types[c.entity_type]||'Мебельный бренд'} · Москва и МО</span><h3>{c.name}</h3><p class="studio-location">{c.geography_note}</p></div></div><p class="studio-description">{c.description}</p><dl class="studio-facts"><div><dt>Материалы и технологии</dt><dd>{c.materials_and_technologies_mentioned.map(m=>m.name).join(', ')||'Запросите спецификацию изделия'}</dd></div><div><dt>Гарантия</dt><dd>{c.warranty?.summary||'Запросите срок и условия гарантии в договоре'}</dd></div><div><dt>Телефон</dt><dd>{c.phones.join(', ')||'Контакты на сайте компании'}</dd></div><div><dt>Что учесть</dt><dd>{c.selection_note}</dd></div></dl></div><aside class="studio-action"><a class="index-score" href="#methodology"><strong>{c.score}</strong><span>/ 100<br/>редакционная оценка</span></a><p>{c.tied?'Равный балл с другими участниками':'По методике проекта'}</p><button class="r-button" data-furniture-request={c.name}>Получить предложение ↗</button>{c.position<=10?<a class="studio-website" href={c.website} target="_blank" rel="noopener noreferrer">{c.website.replace(/^https?:\/\//,'')} ↗</a>:<span class="studio-website">{c.website.replace(/^https?:\/\//,'')}</span>}</aside><details class="studio-details"><summary>Баллы, условия и источники <span>＋</span></summary><div class="furniture-evidence">{c.criteria.map((a,i)=><div><h4>{criterionNames[i]} — {a.points}/{a.max}</h4><p>{a.reason}</p><a href={a.source} target="_blank" rel="noopener noreferrer">Источник ↗</a></div>)}</div><p class="r-note">Дата исследования: 12.10.2026. География продаж не означает расположение производства в Москве.</p></details><button class="furniture-correction" data-correction={c.id} data-company={c.name}>Это ваша компания? Исправить информацию ↗</button></article>)}</div><p id="furniture-empty" hidden>Совпадений нет. Попробуйте другое название или сбросьте фильтры.</p></section>
<section id="guide" class="wrap furniture-section"><span class="micro accent">ДО ЗАКАЗА</span><h2>Сначала условия.<br/><em>Потом решение.</em></h2><p class="furniture-intro">{page.guide}</p><div class="furniture-guide"><article><h3>Одинаковая комплектация</h3><p>Сопоставьте материалы, размеры, фурнитуру и отделку. Уточните, относятся ли фотографии к выбранной модели или показывают другую комплектацию.</p></article><article><h3>Доставка в Москву и МО</h3><p>Попросите отдельно указать стоимость доставки до вашего адреса, подъёма и сборки. Согласуйте дату, доступ к помещению и порядок приёмки.</p></article><article><h3>Гарантия по пунктам</h3><p>У корпуса, механизма и обивки могут быть разные сроки гарантии. Зафиксируйте условия ремонта, замены и обращения к продавцу в договоре.</p></article></div></section>
<section id="methodology" class="wrap furniture-section"><span class="micro accent">МЕТОДИКА / ШЕСТЬ КРИТЕРИЕВ</span><h2>Понятно, <em>за что балл.</em></h2><p class="furniture-intro">Оцениваем профильный ассортимент и доступные перед заказом сведения. Сумма шести критериев — до 100 баллов. Это не рейтинг отзывов и не результат испытания мебели. Профильный балл рассчитывается отдельно для каждого направления.</p><div class="furniture-guide">{criterionNames.map((name,i)=><article><h3>{name}</h3><p>До {weights[i]} баллов.</p><p>{['Профильный ассортимент — 20; параметры выбора или индивидуального изготовления — ещё 5.','Каталог бренда — 5; заявление об изготовлении — 15; описание процессов, площадки или оборудования — 20.','Одна раскрытая группа материалов — 5; две — 10; три и более — 15.','Контактный канал — 5; перечень услуг — 10; отдельные условия доставки или сервиса — 15.','Раздел гарантии — 5; публичный срок — 10; срок и отдельные условия — 15.','Прямой телефон или email — 5; числовые цены изделий — ещё 5.'][i]}</p></article>)}</div><p class="r-note">Исходные сведения — предоставленное редакции исследование мебельных компаний от 12 октября 2026 года. Для каждой оценки указаны основания и ссылки. При изменении данных направьте исправление через карточку.</p></section>
<section class="wrap furniture-section"><h2>Другие рейтинги <em>Москвы и МО.</em></h2><nav class="furniture-links" aria-label="Мебельные рейтинги">{furniturePages.filter(p=>p.slug!==page.slug).map(p=><a href={p.url}>{labels[p.slug]} <span>{p.rankings.length} компаний ↗</span></a>)}<a href="/ratings/dizayn-interera/moskva/">Студии дизайна интерьера <span>Москва и МО ↗</span></a></nav></section>
</main><footer class="footer wrap"><PartnerInvitation/><LegalNotice/><ProjectCredit/></footer><FurnitureRequest category={label}/><EditorialDialog/><Metrika/>
<script>
 const form=document.querySelector<HTMLFormElement>('#furniture-filters')!;const list=document.querySelector('#furniture-list')!;const cards=[...list.querySelectorAll<HTMLElement>('article[data-company]')];
 function filter(){const d=new FormData(form);const q=String(d.get('search')||'').trim().toLowerCase();const type=String(d.get('type')||'');let count=0;cards.sort((a,b)=>d.get('sort')==='name'?a.dataset.name!.localeCompare(b.dataset.name!,'ru'):Number(a.dataset.position)-Number(b.dataset.position)).forEach(c=>{c.hidden=!(c.dataset.search!.includes(q)&&(!type||c.dataset.type===type));if(!c.hidden)count++;list.append(c);});document.querySelector('#furniture-count')!.textContent=`Найдено: ${count} из ${cards.length}`;document.querySelector<HTMLElement>('#furniture-empty')!.hidden=count!==0;}
 form.addEventListener('input',filter);form.addEventListener('change',filter);form.addEventListener('reset',()=>queueMicrotask(filter));
</script>
<style is:global>
.furniture-hero{padding-block:35px 70px}.furniture-hero h1{font-size:clamp(38px,5.8vw,88px);letter-spacing:-.045em;line-height:1.06;margin:32px 0}.furniture-hero em,.furniture-section em,.furniture-promo em{font-family:Georgia,serif;color:#a6bfff;font-weight:400}.furniture-intro{font-size:21px;max-width:960px;line-height:1.7;margin:28px 0}.hero-meta{display:flex;gap:25px;flex-wrap:wrap;color:#b8c3d7;font-size:15px;margin-bottom:30px}.furniture-hero .r-secondary{margin:10px}.furniture-promo{padding:38px;background:linear-gradient(120deg,#263348,#28202d);border:1px solid #465674;border-radius:22px}.furniture-promo h2{font-size:clamp(28px,4vw,48px);margin:18px 0}.furniture-promo p{margin-bottom:25px}.furniture-section{padding-block:70px}.furniture-section>h2{margin:20px 0 28px}.furniture-filters{display:grid;grid-template-columns:2fr 1fr 1fr auto;gap:16px;align-items:end;padding:24px;background:#1b2029;border-radius:18px;margin:30px 0 20px}#furniture-count{margin-bottom:24px;font-size:16px}.furniture-card{margin-bottom:22px}.furniture-evidence,.furniture-guide{display:grid;grid-template-columns:repeat(3,1fr);gap:24px}.furniture-evidence>div,.furniture-guide>article{padding:24px;background:#1a202a;border-radius:14px}.furniture-evidence p,.furniture-guide p{font-size:17px}.furniture-evidence a{display:block;color:#a6bfff;margin-top:14px}.furniture-correction{grid-column:1/-1;padding:22px;border-top:1px solid #3b4556;text-align:left;background:none;color:#adc1ff;font-size:16px}.furniture-links{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}.furniture-links a{padding:26px;border:1px solid #485671;border-radius:14px;font-size:23px}.furniture-links span{display:block;color:#a6bfff;font-size:15px;margin-top:14px}@media(max-width:900px){.furniture-filters{grid-template-columns:1fr 1fr}.furniture-evidence,.furniture-guide,.furniture-links{grid-template-columns:1fr 1fr}}@media(max-width:600px){.furniture-filters,.furniture-evidence,.furniture-guide,.furniture-links{grid-template-columns:1fr}.furniture-section{padding-block:48px}.furniture-intro{font-size:18px}.furniture-promo{padding:25px}.furniture-hero .r-secondary{margin:12px 0}}
</style>
</body></html>
