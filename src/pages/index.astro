import '@fontsource-variable/manrope';
import '../styles/global.css';
import { criteria as moscowCriteria } from '../data/moscow';
import { indexable } from '../data/site';
const categories = [
 {n:'01',title:'Дизайн интерьера',text:'Москва и МО · 175 студий и бюро',type:'interior',symbol:'✳'},
 {n:'02',title:'Мебель',text:'Красиво. Удобно. Надолго.',type:'furniture',symbol:'⌑'},
 {n:'03',title:'Кухни',text:'Место, где происходит жизнь',type:'kitchen',symbol:'◒'},
 {n:'04',title:'Окна',text:'Больше света, меньше забот',type:'windows',symbol:'⊞'},
 {n:'05',title:'Двери',text:'Детали, с которых начинается дом',type:'doors',symbol:'◧'},
 {n:'06',title:'Всё для дома',text:'Свет, отделка и другие важные вещи',type:'all',symbol:'↗'},
];
const criteria = moscowCriteria.map(([name,weight,description])=>[String(weight),name,description]);
const faq = [
 ['Можно ли купить первое место в рейтинге?','Нет. Оплата даёт размещение в отдельном блоке «Промо», но не дополнительные баллы рейтинга. Компания может одновременно присутствовать в промоблоке и в рейтинге — с оценкой на общих основаниях.'],
 ['Как ИИ будет выбирать лучшие компании?','ИИ может помогать сопоставлять материалы. В московском выпуске индекс рассчитывается по десяти критериям с фиксированными весами. Источники и дата сохранены; отсутствие данных обозначается отдельно и даёт ноль по критерию.'],
 ['Если о компании мало информации — она плохая?','Не обязательно. Недостаток данных означает, что мы пока не можем уверенно её оценить. Компания сможет предоставить документы и сведения о проектах, а после проверки алгоритм пересчитает результат.'],
 ['Рейтинг гарантирует идеальный результат?','Рейтинг помогает сузить выбор, но не заменяет личное знакомство с командой и внимательное изучение условий. Мы советуем обсудить вашу задачу с несколькими компаниями и сравнить предложения по одинаковому составу работ.'],
 ['Когда появятся рейтинги и статьи?','Уже подготовлен рейтинг 175 студий и бюро Москвы и МО. Он доступен в разделе «Дизайн интерьера». Другие направления и журнал пока готовятся.']
];
const schema = {'@context':'https://schema.org','@graph':[{'@type':'Organization','@id':'https://best-of-interiors.ru/#organization',name:'Best of Interiors',url:'https://best-of-interiors.ru/'},{'@type':'WebSite','@id':'https://best-of-interiors.ru/#website',name:'Best of Interiors',url:'https://best-of-interiors.ru/',inLanguage:'ru-RU',publisher:{'@id':'https://best-of-interiors.ru/#organization'}},{'@type':'AboutPage','@id':'https://best-of-interiors.ru/#webpage',url:'https://best-of-interiors.ru/',name:'Best of Interiors — осознанный выбор компаний для вашего дома',isPartOf:{'@id':'https://best-of-interiors.ru/#website'},inLanguage:'ru-RU',about:{'@id':'https://best-of-interiors.ru/#organization'}}]};
---
<!doctype html><html lang="ru"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="theme-color" content="#101112"/><title>Best of Interiors — выбор студий дизайна, мебели и кухонь</title><meta name="description" content="Помогаем выбрать студию дизайна интерьера, производителя мебели, кухонь, окон и дверей. Понятные критерии, проверяемые данные и честное разделение рейтинга и промо."/><meta name="robots" content={indexable ? "index, follow, max-image-preview:large" : "noindex, follow"}/><link rel="canonical" href="https://best-of-interiors.ru/"/><link rel="icon" type="image/svg+xml" href="/favicon.svg"/><meta property="og:type" content="website"/><meta property="og:locale" content="ru_RU"/><meta property="og:title" content="Ваш дом. Ваши люди. — Best of Interiors"/><meta property="og:description" content="Осознанный выбор компаний для дома. От первого эскиза до последней детали."/><meta property="og:url" content="https://best-of-interiors.ru/"/><script type="application/ld+json" set:html={JSON.stringify(schema)}/></head>
<body><a class="skip" href="#main">Перейти к содержимому</a>
<header class="header wrap"><a class="brand" href="/" aria-label="Best of Interiors — главная">best of<span>interiors<i>✳</i></span></a><nav aria-label="Главная навигация"><a href="#about">О проекте</a><a href="#categories">Рейтинги <span>↗</span></a><a href="#method">Как выбираем</a><a href="#journal">Журнал</a></nav><a class="header-cta" href="#categories">Найти своих <span>↗</span></a><button class="menu-toggle" aria-expanded="false" aria-controls="mobile-menu" aria-label="Открыть меню">☰</button></header>
<nav id="mobile-menu" class="mobile-menu" hidden aria-label="Мобильная навигация"><a href="#about">О проекте</a><a href="#categories">Рейтинги</a><a href="#method">Как выбираем</a><a href="#journal">Журнал</a></nav>
<main id="main">
<section class="hero wrap" aria-labelledby="hero-title"><div class="eyebrow"><span class="dot"></span> ГИД ПО ЛЮДЯМ, КОТОРЫЕ СОЗДАЮТ ДОМ <span class="edition">ПЕРВЫЙ ВЫПУСК / 2026</span></div><div class="hero-title"><h1 id="hero-title">Ваш дом.<br/><span>Ваши люди.</span></h1><div class="hero-intro"><p>Красивый интерьер начинается<br class="desktop"/> с тех, кому можно доверить важное.</p><p class="muted">Помогаем выбрать студию дизайна и производителей для дома — спокойно, вдумчиво и с опорой на факты.</p><a class="hero-action" href="#categories">Найти своих <span>↗</span></a></div></div>
<div class="hero-stage" aria-hidden="true"><img src="/images/atmosphere-1800.webp" srcset="/images/atmosphere-640.webp 640w, /images/atmosphere-1200.webp 1200w, /images/atmosphere-1800.webp 1800w" sizes="100vw" width="1536" height="1024" fetchpriority="high" alt=""/></div><div class="hero-object"><img src="/images/hero-640.webp" width="640" height="427" alt="Скульптурное кресло в интерьере — концептуальная иллюстрация"/><div><span class="tiny">МЕНЬШЕ СОМНЕНИЙ.</span><p>Больше вашего.</p><span class="hero-object-note">AI-концепт интерьера</span></div><span aria-hidden="true">↗</span></div><button class="motion-toggle" aria-pressed="false" aria-label="Приостановить анимацию">Ⅱ</button><div class="hero-bottom"><span>От первого эскиза до последней детали</span><span>ЛИСТАЙТЕ, МЫ ВСЁ ОБЪЯСНИМ ↓</span></div></section>
<section id="categories" class="categories wrap section"><div class="section-top"><span class="eyebrow">01 / С ЧЕГО НАЧНЁМ?</span><span class="tiny">ШЕСТЬ НАПРАВЛЕНИЙ. ОДИН ВАШ ДОМ.</span></div><div class="section-heading"><h2>Хорошие решения.<br/><span class="muted">В каждой детали.</span></h2><p>Для большой мечты о доме<br/>и маленьких, но важных задач.</p></div><div class="category-grid">{categories.map(c=>{const Tag=c.type==='interior'?'a':'button';return <Tag class={`category ${c.type}`} href={c.type==='interior'?'/ratings/dizayn-interera/moskva/':undefined} data-category={c.type==='interior'?undefined:c.title}><span class="card-top"><span>{c.n}</span><span class="mini-arrow">↗</span></span><span class="category-art" aria-hidden="true">{c.symbol}</span><span class="category-name">{c.title}</span><span class="category-desc">{c.text}</span></Tag>})}</div><div class="launch-note"><span class="dot"></span><span>Первый рейтинг: студии дизайна интерьера Москвы и МО. Другие направления готовим к выпуску.</span></div></section>
<section id="about" class="about section"><div class="wrap about-layout"><div><span class="eyebrow">02 / МЫ НА ВАШЕЙ СТОРОНЕ</span><h2>Хочется дом мечты.<br/><span>А не вторую работу.</span></h2><p class="about-intro">Сотни вкладок, противоречивые отзывы и сметы, которые сложно сравнить. Знакомо? Мы создаём Best of Interiors, чтобы путь к дому стал понятнее.</p><div class="signature"><span class="signature-star">✳</span><span>Вы выбираете, как жить.<br/>Мы помогаем разобраться, с кем строить.</span></div></div><div class="concerns"><article><span>01</span><div><h3>«А вдруг красиво только на фото?»</h3><p>Показываем, что компания сообщает о проектах и где это можно посмотреть. Отмечаем, если реализация не проверена независимо.</p></div></article><article><span>02</span><div><h3>«Боюсь, что бюджет вырастет вдвое»</h3><p>Обращаем внимание на состав сметы и прозрачность условий. Подсказываем, что уточнить до первого платежа.</p></div></article><article><span>03</span><div><h3>«Как понять, кому верить?»</h3><p>Показываем основания оценки и то, чего пока не знаем. Рекламу обозначаем отдельно — вам не придётся её угадывать.</p></div></article></div></div></section>
<section id="method" class="method wrap section"><div class="section-top"><span class="eyebrow">03 / ДОВЕРИЕ В ДЕТАЛЯХ</span><span class="tiny">МОСКОВСКИЙ РЕЙТИНГ / ВЕРСИЯ 1.0</span></div><div class="section-heading"><h2>За каждым местом —<br/><span class="muted">понятные основания.</span></h2><p>Открытые данные и понятный расчёт.<br/>Не гарантия качества ремонта.</p></div><div class="method-layout"><div class="score-card"><span class="tiny">10 КРИТЕРИЕВ ОТКРЫТОСТИ</span><div class="score-art"><span>100</span><i>✳</i></div><h3>Факты складываются<br/>в общую картину.</h3><p>В московском выпуске алгоритм оценивает раскрытые сведения по десяти критериям. Платные размещения не дают дополнительных баллов.</p><a href="#method-details" class="text-link">Как устроена оценка <span>↗</span></a></div><div class="criteria">{criteria.map(([weight,title,description])=><article><div><h3>{title}</h3><p>{description}</p></div><span>{weight}<small>%</small></span></article>)}</div></div><details id="method-details" class="method-details"><summary>Источники, недостающие данные и пересмотр оценки <span>+</span></summary><div><p>В первом московском выпуске используем официальные материалы компаний. В карточках доступны ссылки, дата и статус сведений. Офисы, отзывы и качество реализованных объектов независимо не проверялись.</p><p>Индекс = сумма (вес × коэффициент от 0 до 1). Если данные не найдены, критерий получает 0. Это не доказательство отсутствия услуги или плохого качества. Одинаковые баллы дают одинаковое место внутри сегмента.</p><p>Компания может дополнить сведения подтверждающими материалами. После проверки применяется та же формула. Подробная шкала и ограничения опубликованы на странице рейтинга.</p><a class="text-link" href="/ratings/dizayn-interera/moskva/#methodology">Методика московского рейтинга ↗</a></div></details></section>
<section class="promo-section wrap" id="promo"><div class="promo-copy"><span class="pill">ПРОМО / О ФОРМАТЕ</span><h2>Можно быть заметнее.<br/>Нельзя купить доверие.</h2><p>В специальных подборках будут предложения партнёров: знакомство с коллекциями, акции и полезные решения для дома.</p><p class="muted">Платные размещения всегда помечены «Промо». Они не меняют баллы и места в рейтинге.</p><button class="text-link" data-info="promo">О партнёрских размещениях <span>↗</span></button></div><div class="promo-image"><img loading="lazy" src="/images/kitchen-1200.webp" width="1536" height="1024" alt="Кухня с ореховыми фасадами, стальным островом и жёлтым светильником — концептуальная иллюстрация"/><span class="image-label">ПРОСТРАНСТВО ДЛЯ ХОРОШИХ ИДЕЙ</span></div></section>
<section id="journal" class="journal wrap section"><div class="section-top"><span class="eyebrow">04 / ЖУРНАЛ О ВАШЕМ ДОМЕ</span><span class="tiny">ГОТОВИМ К ПУБЛИКАЦИИ</span></div><div class="section-heading"><h2>Чуть больше знаний.<br/><span class="muted">Гораздо меньше тревог.</span></h2><p>Вопросы редакции.<br/>Ответы практикующих специалистов.</p></div><div class="journal-grid"><article class="story story-photo"><div class="story-visual"><img loading="lazy" src="/images/kitchen-640.webp" width="640" height="427" alt="Детали современной кухни из дерева и металла"/><span class="pill">ПЛАНИРУЕМ МАТЕРИАЛ</span></div><span class="tiny">КУХНИ / ПРАКТИКА ВЫБОРА</span><h3>Кухня на заказ: что спросить<br/>до первого замера</h3><p>Разберём комплектацию, материалы и то, что часто остаётся за пределами стартовой цены.</p><span class="byline">Редакция + эксперт производства · в подготовке</span></article><article class="story"><div class="story-visual visual-blue"><span class="pill">ПЛАНИРУЕМ МАТЕРИАЛ</span><span class="editorial-art" aria-hidden="true">₽<span>?</span></span><span class="visual-caption">СЧИТАТЬ —<br/>ЭТО ЗАБОТИТЬСЯ</span></div><span class="tiny">ДИЗАЙН / БЮДЖЕТ</span><h3>Из чего на самом деле<br/>складывается цена дизайн-проекта</h3><p>Научимся сравнивать предложения по составу работ, а не только по цене за метр.</p><span class="byline">Редакция + дизайнер · в подготовке</span></article><article class="story"><div class="story-visual visual-wine"><span class="pill">ПЛАНИРУЕМ МАТЕРИАЛ</span><span class="abstract" aria-hidden="true">✳</span><span class="visual-caption">КРАСИВОЕ —<br/>ЕЩЁ НЕ ВСЁ</span></div><span class="tiny">МЕБЕЛЬ / МАТЕРИАЛЫ</span><h3>Как выбрать мебель,<br/>с которой захочется жить</h3><p>Обсудим образцы, конструкцию и уход — всё, что не помещается на красивой фотографии.</p><span class="byline">Редакция + эксперт производства · в подготовке</span></article></div></section>
<section class="faq wrap section"><div><span class="eyebrow">05 / ДАВАЙТЕ НАЧИСТОТУ</span><h2>Хорошие вопросы.<br/><span class="muted">Прямые ответы.</span></h2></div><div class="faq-list">{faq.map(([q,a])=><details><summary>{q}<span>+</span></summary><p>{a}</p></details>)}</div></section>
<section class="closing wrap"><span class="eyebrow">ДОМ НАЧИНАЕТСЯ С ВАШЕГО «ХОЧУ»</span><h2>Пусть всё<br/>сложится<span class="closing-star" aria-hidden="true">✳</span><em>по-вашему.</em></h2><a class="button-dark" href="#categories">С чего начнём? <span>↗</span></a></section>
</main><footer class="footer wrap"><div class="footer-top"><a class="brand" href="/">best of<span>interiors<i>✳</i></span></a><p>Люди. Решения. Ваш дом.</p><a href="#method">Как устроен рейтинг ↗</a><button data-info="company">Для компаний ↗</button></div><div class="footer-bottom"><span>© 2026 Best of Interiors</span><span>Московский выпуск · 2026</span><span>С заботой о вашем выборе.</span></div></footer>
<dialog id="info-dialog" aria-labelledby="dialog-title"><button class="dialog-close" aria-label="Закрыть окно">×</button><span class="eyebrow" id="dialog-kicker">ПЕРВЫЙ ВЫПУСК</span><h2 id="dialog-title"></h2><p id="dialog-copy"></p><a class="button-dark" href="#method">Посмотреть критерии <span>↗</span></a></dialog>
<script>
const motionPreference = window.matchMedia('(prefers-reduced-motion: reduce)');
const motionToggle = document.querySelector<HTMLButtonElement>('.motion-toggle');
let motionPaused = motionPreference.matches;
function updateMotion(){document.documentElement.dataset.motion=motionPaused?'paused':'running';motionToggle?.setAttribute('aria-pressed',String(motionPaused));motionToggle?.setAttribute('aria-label',motionPaused?'Включить анимацию':'Приостановить анимацию');if(motionToggle)motionToggle.textContent=motionPaused?'▷':'Ⅱ';if(motionPaused)document.getAnimations().forEach(animation=>{if(animation instanceof CSSAnimation)return;animation.finish();});}
motionToggle?.addEventListener('click',()=>{motionPaused=!motionPaused;updateMotion();});
motionPreference.addEventListener('change',()=>{motionPaused=motionPreference.matches;updateMotion();});updateMotion();
const revealObserver=new IntersectionObserver(entries=>{entries.forEach(entry=>{if(entry.isIntersecting){if(!motionPaused)entry.target.animate([{opacity:0,transform:'translateY(24px)'},{opacity:1,transform:'translateY(0)'}],{duration:700,easing:'cubic-bezier(.2,.7,.2,1)',fill:'none'});revealObserver.unobserve(entry.target);}});},{threshold:.12});
document.querySelectorAll('.section-heading,.category,.concerns article,.story,.closing').forEach(el=>revealObserver.observe(el));

const menu = document.querySelector<HTMLButtonElement>('.menu-toggle');
const mobile = document.querySelector<HTMLElement>('#mobile-menu');
menu?.addEventListener('click',()=>{const expanded=menu.getAttribute('aria-expanded')==='true';menu.setAttribute('aria-expanded',String(!expanded));menu.setAttribute('aria-label',expanded?'Открыть меню':'Закрыть меню'); if(mobile) mobile.hidden=expanded;});
mobile?.querySelectorAll('a').forEach(a=>a.addEventListener('click',()=>{mobile.hidden=true;menu?.setAttribute('aria-expanded','false');menu?.setAttribute('aria-label','Открыть меню');}));
const dialog=document.querySelector<HTMLDialogElement>('#info-dialog');
function openInfo(title:string,copy:string){document.querySelector('#dialog-title')!.textContent=title;document.querySelector('#dialog-copy')!.textContent=copy;dialog?.showModal();}
document.querySelectorAll<HTMLButtonElement>('[data-category]').forEach(b=>b.addEventListener('click',()=>openInfo(b.dataset.category||'Рейтинг','Готовим первый рейтинг в этом направлении. Сначала соберём и проверим сведения о компаниях, затем покажем оценки, источники и контакты. Пока можно познакомиться с критериями выбора.')));
document.querySelectorAll<HTMLButtonElement>('[data-info]').forEach(b=>b.addEventListener('click',()=>openInfo(b.dataset.info==='promo'?'Заметное промо. Прозрачные правила.':'Компаниям есть что рассказать',b.dataset.info==='promo'?'В рейтингах предусмотрен отдельный промоблок — до трёх компаний. Также планируем партнёрские статьи, врезки в карточках и предложения на главной. Порядок промо может быть платным; органический рейтинг рассчитывается отдельно. Приём заявок откроется после запуска.':'Вы сможете бесплатно передать подтверждения реализованных проектов, сведения об условиях, гарантиях и команде. Проверенные данные станут основанием для пересчёта оценки. Форма подачи появится вместе с первыми рейтингами.')));
dialog?.querySelector('.dialog-close')?.addEventListener('click',()=>dialog.close());dialog?.querySelector('a')?.addEventListener('click',()=>dialog.close());dialog?.addEventListener('click',e=>{if(e.target===dialog){const r=dialog.getBoundingClientRect();if(e.clientX<r.left||e.clientX>r.right||e.clientY<r.top||e.clientY>r.bottom)dialog.close();}});
</script></body></html>
