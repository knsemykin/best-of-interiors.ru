---
import PartnerInvitation from '../../../components/PartnerInvitation.astro';
import SiteHeader from '../../../components/SiteHeader.astro';
import ProjectCredit from '../../../components/ProjectCredit.astro';
import LegalNotice from '../../../components/LegalNotice.astro';
import Metrika from '../../../components/Metrika.astro';
import '@fontsource-variable/manrope';
import '../../../styles/global.css';
import { indexable } from '../../../data/site';
import { windowDirections, windowCompanies } from '../../../data/windows-moscow';
import { companies } from '../../../data/windows';
const descriptions = [
 'Производители и установщики ПВХ-окон. Сравните профильные системы, комплектацию, монтаж и гарантии.',
 'Тёплый и холодный алюминий для дома, квартиры и панорамного остекления. Компании, системы и условия работы.',
 'Фасадное остекление, витражи, входные группы и зимние сады. Найдите компанию под масштаб вашего проекта.',
 'Холодное и тёплое остекление, раздвижные конструкции и отделка. Сравните решения для вашего балкона.'
];
const cards = [
 ...windowDirections.map((d,i)=>({name:d.name,region:'Москва и Московская область',count:windowCompanies(d.code).length,description:descriptions[i],url:d.url})),
 {name:'Оконные компании Воронежа',region:'Воронеж и Воронежская область',count:companies.length,description:'Производители, продавцы и монтажные компании. Окна для квартиры и дома, установка и обслуживание.',url:'/ratings/okna/voronezh/'}
];
const companyWord=(n:number)=>n%100>=11&&n%100<=14?'КОМПАНИЙ':n%10===1?'КОМПАНИЯ':[2,3,4].includes(n%10)?'КОМПАНИИ':'КОМПАНИЙ';
const title='Рейтинги оконных компаний Москвы, МО и Воронежа — 2026';
const description='Выберите рейтинг оконных компаний: пластиковые и алюминиевые окна, фасадное остекление, балконы и лоджии в Москве и МО, оконные компании Воронежа.';
const canonical='https://best-of-interiors.ru/ratings/okna/';
const schema={'@context':'https://schema.org','@type':'CollectionPage',name:title,url:canonical,description,mainEntity:{'@type':'ItemList',numberOfItems:cards.length,itemListElement:cards.map((c,i)=>({'@type':'ListItem',position:i+1,name:c.name+' — '+c.region,url:'https://best-of-interiors.ru'+c.url}))}};
---
<!doctype html>
<html lang="ru">
<head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>{title} | Best of Interiors</title><meta name="description" content={description}/><meta name="robots" content={indexable?'index,follow':'noindex,follow'}/><link rel="canonical" href={canonical}/><script type="application/ld+json" set:html={JSON.stringify(schema)}/></head>
<body>
<SiteHeader/>
<main id="main" class="wrap windows-directory">
 <nav class="crumbs" aria-label="Хлебные крошки"><a href="/">Главная</a><span aria-hidden="true">/</span><span>Окна</span></nav>
 <header class="directory-heading"><div><span class="eyebrow">РЕЙТИНГИ / 2026</span><h1>Окна для вашего <em>дома.</em></h1></div><p>Выберите город и задачу.<br/>Затем — компанию, которой доверите остекление.</p></header>
 <div class="city-grid">{cards.map((c,i)=><a class="city-card" href={c.url}>
  <div class="city-card-top"><span class="eyebrow">{String(i+1).padStart(2,'0')} / {c.count} {companyWord(c.count)}</span><svg viewBox="0 0 32 32" fill="none" aria-hidden="true"><path d="M6 26 26 6M6 6h20v20" stroke="currentColor" stroke-width="1.8"/></svg></div>
  <span class="region">{c.region}</span><h2>{c.name}</h2><p>{c.description}</p>
  <span class="city-card-bottom">Смотреть рейтинг <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 12h16m-6-6 6 6-6 6" stroke="currentColor" stroke-width="1.5"/></svg></span>
 </a>)}</div>
 <section class="directory-guide"><h2>Найдите компанию<br/>под вашу задачу.</h2><div><p>В рейтингах оконных компаний собраны сведения о производстве, профильных системах, монтаже и гарантиях. Сравнивайте состав предложения: одинаковые размеры окна ещё не означают одинаковую комплектацию.</p><p>Для Москвы и области подготовлены четыре отдельных направления. В рейтинге Воронежа можно отфильтровать компании, изучить услуги и запросить предложение.</p><a href="/ratings/okna/moskva/">Все направления Москвы и МО →</a></div></section>
</main>
<footer class="footer wrap"><PartnerInvitation/><LegalNotice/><ProjectCredit/></footer><Metrika/>
</body></html>
<style>
.windows-directory{padding-top:32px}.crumbs{display:flex;gap:14px;flex-wrap:wrap;color:#aeb5c2;font-size:16px}.crumbs a:hover{color:#adc1ff}.directory-heading{display:flex;align-items:flex-end;justify-content:space-between;gap:40px;padding:60px 0 44px}.eyebrow{font-size:13px;font-weight:650;letter-spacing:.09em}.directory-heading .eyebrow{color:#adc1ff}.directory-heading h1{font-size:clamp(42px,5vw,76px);line-height:1.1;letter-spacing:-.055em;margin-top:28px}.directory-heading em{font-family:Georgia,serif;color:#adc1ff;font-weight:400}.directory-heading p{max-width:365px;color:#b9bec8;font-size:20px}.city-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:24px}.city-card{display:flex;flex-direction:column;min-width:0;background:linear-gradient(135deg,#212733,#151719);border:1px solid #414958;border-radius:24px;padding:38px;transition:transform .2s,border-color .2s}.city-card:hover{transform:translateY(-5px);border-color:#a6bfff}.city-card-top,.city-card-bottom{display:flex;justify-content:space-between;align-items:center;gap:15px}.city-card-top svg{width:38px;height:38px;color:#adc1ff;flex-shrink:0}.region{margin-top:40px;color:#adc1ff;font-size:16px}.city-card h2{font-size:clamp(32px,3.5vw,52px);line-height:1.15;letter-spacing:-.045em;margin:14px 0 24px}.city-card p{font-size:20px;color:#c7cbd5;line-height:1.6;max-width:560px;margin-bottom:38px}.city-card-bottom{border-top:1px solid #414958;padding-top:24px;margin-top:auto;font-size:19px;color:#adc1ff}.city-card-bottom svg{width:24px;height:24px;flex-shrink:0}.directory-guide{display:grid;grid-template-columns:1fr 1fr;gap:60px;padding:90px 0}.directory-guide h2{font-size:clamp(32px,4vw,54px);line-height:1.15;letter-spacing:-.04em}.directory-guide p{font-size:20px;color:#c7cbd5;margin-bottom:24px}.directory-guide a{color:#adc1ff;text-decoration:underline;text-underline-offset:5px}@media(max-width:760px){.directory-heading{display:block;padding:40px 0 30px}.directory-heading p{margin-top:24px;font-size:18px}.city-grid,.directory-guide{grid-template-columns:1fr}.city-card{padding:26px}.city-card p{font-size:18px}.city-card h2{font-size:34px}.region{margin-top:28px}.directory-guide{gap:28px;padding:60px 0}.directory-guide p{font-size:18px}}@media(prefers-reduced-motion:reduce){.city-card{transition:none}.city-card:hover{transform:none}}
</style>
