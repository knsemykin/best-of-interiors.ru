---
import '@fontsource-variable/manrope';
import '../../../../styles/global.css';
import '../../../../styles/ranking.css';
import '../../../../styles/windows.css';
import {companies,criteria,promos,path} from '../../../../data/windows';
import {indexable} from '../../../../data/site';
import WindowCard from '../../../../components/WindowCard.astro';
import RankingInteractions from '../../../../components/RankingInteractions.astro';
import LegalNotice from '../../../../components/LegalNotice.astro';
import ProjectCredit from '../../../../components/ProjectCredit.astro';
import Metrika from '../../../../components/Metrika.astro';
const title=`ТОП-${companies.length} оконных компаний Воронежа — рейтинг 2026 | Best of Interiors`;
const description='Оконные компании Воронежа и области: сравните производителей и установщиков, профили, гарантии и условия. 32 компании, методика оценки и запрос предложений под ваш объект.';
const url='https://best-of-interiors.ru'+path;
const faq=[['Как выбрать оконную компанию в Воронеже?','Сравните одинаковую комплектацию, уточните изготовителя готового окна, состав монтажных работ и гарантию. Попросите договор, подробную смету и примеры похожих объектов.'],['Что лучше: завод или дилер?','Важны прозрачная цепочка поставки и ответственность по договору. Дилер может работать с хорошим заводом, а собственное производство само по себе не подтверждает качество монтажа. Уточните, кто изготовит окно и кто отвечает за установку.'],['Почему нельзя сравнивать только цену за квадратный метр?','Размеры, створки, стеклопакет, фурнитура, демонтаж, откосы и доставка меняют итоговую стоимость. Сравнивайте полные сметы для одного и того же проёма.'],['Все ли найденные компании включены в рейтинг?','В исходном реестре 301 запись. В рейтинг вошли 31 профиль с рассчитанными критериями и отдельно оценённая Oknapeople. Остальные записи требуют уточнения; отсутствие в рейтинге не означает низкого качества.'],['Означает ли высокий балл лучшее качество окон?','Балл показывает раскрытие сведений по десяти критериям. Это не результат испытаний окон или проверки монтажа. Сроки, качество и гарантийные обязательства уточняйте у исполнителя.'],['Можно получить несколько предложений по одной заявке?','Да. В общем брифе можно выбрать до четырёх компаний или доверить подбор редакции. Сначала запрос получает Best of Interiors; передача компаниям выполняется с вашим отдельным согласием.']];
const schema={'@context':'https://schema.org','@graph':[{'@type':'CollectionPage','@id':url,name:title,description,url,inLanguage:'ru-RU',dateModified:'2026-10-12',publisher:{'@type':'Organization',name:'Best of Interiors',url:'https://best-of-interiors.ru/'}},{'@type':'ItemList',numberOfItems:companies.length,itemListElement:companies.map((c,i)=>({'@type':'ListItem',position:i+1,name:c.name,url:url+'#'+c.company_id}))},{'@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:'Главная',item:'https://best-of-interiors.ru/'},{'@type':'ListItem',position:2,name:'Оконные компании',item:'https://best-of-interiors.ru/ratings/okna/'},{'@type':'ListItem',position:3,name:'Воронеж',item:url}]}]};
---
<!doctype html><html lang="ru"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>{title}</title><meta name="description" content={description}/><meta name="robots" content={indexable?'index,follow,max-image-preview:large':'noindex,follow'}/><link rel="canonical" href={url}/><link rel="icon" href="/favicon.svg"/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:url" content={url}/><meta property="og:type" content="website"/><meta property="og:image" content="https://best-of-interiors.ru/images/windows-garden-1200.webp"/><script type="application/ld+json" set:html={JSON.stringify(schema)}/></head>
<body class="ranking-page windows-page" data-directory="windows"><a class="skip" href="#main">Перейти к содержимому</a><header class="header wrap"><a class="brand" href="/">best of<span>interiors<i>✳</i></span></a><nav><a href="#rating">Рейтинг</a><a href="#methodology">Методика</a><a href="/partners/">Для компаний</a></nav><button class="r-button" data-quiz>Сравнить предложения ↗</button></header><main id="main">
<section class="window-hero wrap"><div><nav class="breadcrumbs" aria-label="Хлебные крошки"><a href="/">Главная</a> / <a href="/ratings/okna/">Окна</a> / Воронеж</nav><span class="micro accent">ВОРОНЕЖ И ОБЛАСТЬ / 12 ОКТЯБРЯ 2026</span><h1>ТОП-{companies.length} лучших оконных компаний <em>Воронежа.</em></h1><p>Рейтинг 2026 · Светлее дома.<br/>Спокойнее при выборе.</p><p>Сравните компании по комплектации, монтажу и гарантиям. Выберите тех, кому готовы доверить тепло вашего дома.</p><button class="r-button" data-quiz>Один запрос — несколько расчётов ↗</button><span class="r-note">Бесплатно · около 3 минут</span></div><figure><img src="/images/windows-garden-1200.webp" srcset="/images/windows-garden-640.webp 640w, /images/windows-garden-1200.webp 1200w" sizes="(max-width:850px) 100vw, 50vw" width="1536" height="1024" alt="Светлый интерьер с панорамным остеклением — концептуальная иллюстрация" fetchpriority="high"/><figcaption>Иллюстрация проекта · не портфолио компании</figcaption></figure></section>
<nav class="window-nav wrap" aria-label="Разделы"><a href="#promotions">ПРОМО</a><a href="#rating">32 компании</a><a href="#guide">Как сравнивать</a><a href="#methodology">Критерии</a><a href="#questions">Вопросы</a></nav>
<section id="promotions" class="wrap window-section"><span class="micro accent">01 / ЗНАКОМСТВО КРУПНЫМ ПЛАНОМ</span><div class="section-heading"><h2>Окна под вашу жизнь.<br/><em>И ваш бюджет.</em></h2><a class="text-link" href="/partners/">Обсудить сотрудничество ↗</a></div><div class="window-promos">{promos.map((p,i)=><article class={`window-promo window-promo-${i}`} data-promo-recipient={p.id} data-name={p.name}><figure><img src={p.image} srcset={`${p.image.replace("1200","640")} 640w, ${p.image} 1200w`} sizes="(max-width:850px) 100vw, 50vw" width="1536" height="1024" loading="lazy" alt="Концептуальная иллюстрация современного остекления"/><span class="promo-badge">ПРОМО</span><figcaption>Концепт · не работа компании</figcaption></figure><div class="window-promo-body"><span class="micro">{p.eyebrow}</span><h3>{p.name}</h3><h4>{p.title.split('\n').map(t=><span>{t}</span>)}</h4><p>{p.text}</p><ul>{p.benefits.map(b=><li><span aria-hidden="true">↗</span>{b}</li>)}</ul><strong class="window-offer">{p.offer}</strong><p class="r-note">{p.note}</p><button class="r-button" data-lead={p.id}>{p.cta} ↗</button><a class="studio-website" href={p.url} target="_blank" rel="noopener noreferrer sponsored">Сайт компании ↗</a><p class="r-note">По материалам компании · 12.10.2026</p></div></article>)}</div></section>
<section id="rating" class="wrap window-section"><span class="micro accent">02 / ВЫБИРАЙТЕ ПО ВАЖНОМУ</span><h2>Найдите свою<br/><em>оконную компанию.</em></h2><p class="window-intro">Профили, гарантии, контакты и основания каждого балла — рядом. Добавьте до четырёх компаний в сравнение.</p><form id="filters" class="window-filters"><label>Поиск<input id="search" type="search" placeholder="Компания, профиль или адрес"/></label><label>Тип компании<select id="team-type"><option value="all">Все компании</option><option value="manufacturer">Производители по материалам</option><option value="seller">Продажа и монтаж</option></select></label><label>География<select id="office"><option value="all">Воронеж и область</option><option value="local">Воронеж</option><option value="region">Область</option></select></label><select id="segment" hidden aria-label="Направление"><option value="all">Все</option><option value="windows">Окна</option></select><select id="budget" hidden aria-label="Стоимость"><option value="all">Все</option></select><input type="checkbox" id="supervision" hidden aria-label="Сопровождение"/><input type="checkbox" id="procurement" hidden aria-label="Комплектация"/><input type="checkbox" id="renovation" hidden aria-label="Реализация"/><button class="r-secondary" type="reset">Сбросить</button></form><div class="window-results"><span id="result-count">Найдено: {companies.length} из {companies.length}</span><label>Порядок <select id="sort"><option value="score">По индексу сведений</option><option value="name">По названию</option></select></label></div><div id="studio-list">{companies.map(c=><WindowCard company={c}/>)}</div><div id="empty-state" hidden><p>Совпадений нет. Попробуйте другое название или сбросьте фильтры.</p><button id="empty-reset" class="r-secondary">Сбросить фильтры</button></div><div class="window-results"><span id="page-status">Показано 32 из 32</span><button id="load-more" class="r-button" hidden>Показать ещё</button></div></section>
<section id="guide" class="wrap window-section"><span class="micro accent">03 / ЦЕНА БЕЗ СЮРПРИЗОВ</span><h2>Сравнивайте смету.<br/><em>Не только цифру «от».</em></h2><div class="window-guide">{[['01','Одна комплектация','Отправьте всем одинаковые размеры, количество створок и пожелания к профилю, стеклопакету и фурнитуре.'],['02','Весь монтаж','Уточните демонтаж, доставку, подъём, монтажный шов, откосы, подоконник, отлив и вывоз мусора.'],['03','Понятная гарантия','Отдельно зафиксируйте ответственность за изделие, установку и обслуживание. Название профильной системы не заменяет имя изготовителя окна.']].map(([n,t,d])=><article><span>{n}</span><h3>{t}</h3><p>{d}</p></article>)}</div><button class="r-button" data-quiz>Описать задачу один раз ↗</button></section>
<section id="methodology" class="wrap window-section"><span class="micro accent">04 / ОСНОВАНИЯ ВМЕСТО ОБЕЩАНИЙ</span><h2>За баллом —<br/><em>конкретные сведения.</em></h2><p class="window-intro">10 критериев по 10 баллов. Каждая из двух проверок даёт 5 баллов. Сумма оценивает раскрытие информации, а не результат испытаний окон или монтажа. Рейтинг подготовлен редакцией Best of Interiors по материалам исследования и официальных сайтов на 12 октября 2026 года.</p><div class="window-criteria">{criteria.map(c=><details><summary>{c.name}<span>10 баллов</span></summary><p>{c.rubric}</p></details>)}</div><p class="r-note">При равных баллах расчётный ранг совпадает, внутри группы — алфавитный порядок. Номера карточек последовательные. 270 записей исходного реестра не имели оценки; после отдельной проверки Oknapeople в рейтинге 32 компании. Промышленные подразделения без сопоставимых розничных условий не включены.</p><a class="text-link" href="/methodology/">Общая методика проекта ↗</a></section>
<section id="questions" class="wrap window-section"><h2>Перед заказом<br/><em>стоит разобраться.</em></h2><div class="window-criteria">{faq.map(([q,a])=><details><summary>{q}<span>＋</span></summary><p>{a}</p></details>)}</div></section><section class="wrap window-section window-closing"><h2>Больше ясности.<br/><em>Меньше звонков.</em></h2><p>Один подробный запрос поможет компаниям рассчитать именно ваши окна.</p><button class="r-button" data-quiz>Получить предложения бесплатно ↗</button><p><a href="/ratings/dizayn-interera/voronezh/">Также в Воронеже: рейтинг студий дизайна интерьера ↗</a></p></section>
</main><footer class="footer wrap"><a href="/">Best of Interiors</a><a href="/ratings/okna/">Оконные компании</a><a href="/partners/">Для компаний</a><LegalNotice/><ProjectCredit/></footer><button class="rank-motion" hidden>Ⅱ</button><RankingInteractions city="Воронеж" windows/><Metrika/></body></html>
