---
import ProjectCredit from '../../../components/ProjectCredit.astro';
import '@fontsource-variable/manrope';
import '../../../styles/global.css';
import '../../../styles/ranking.css';
import Metrika from '../../../components/Metrika.astro';
import {designCities} from '../../../data/directory';
import {indexable} from '../../../data/site';
const canonical='https://best-of-interiors.ru/ratings/dizayn-interera/';
const title='Рейтинги студий дизайна интерьера по городам — Best of Interiors';
const description='Выберите город и сравните студии дизайна интерьера: Москва и область, Санкт-Петербург, Екатеринбург, Казань, Воронеж и область. Цены, услуги, портфолио и критерии оценки компаний.';
const schema={'@context':'https://schema.org','@graph':[
 {'@type':'CollectionPage',name:title,url:canonical,description,inLanguage:'ru-RU'},
 {'@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:'Главная',item:'https://best-of-interiors.ru/'},{'@type':'ListItem',position:2,name:'Дизайн интерьера',item:canonical}]},
 {'@type':'ItemList',name:'Рейтинги студий дизайна интерьера по городам',numberOfItems:designCities.length,itemListElement:designCities.map((c,i)=>({'@type':'ListItem',position:i+1,name:c.region,url:`https://best-of-interiors.ru${c.url}`}))}
]};
---
<!doctype html><html lang="ru"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="theme-color" content="#101112"/><title>{title}</title><meta name="description" content={description}/><meta name="robots" content={indexable?'index, follow, max-image-preview:large':'noindex, follow'}/><link rel="canonical" href={canonical}/><link rel="icon" href="/favicon.svg"/><meta property="og:type" content="website"/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/><meta property="og:image" content="https://best-of-interiors.ru/images/moscow-portal-1200.webp"/><script type="application/ld+json" set:html={JSON.stringify(schema)}/></head>
<body class="ranking-page"><a class="skip" href="#main">Перейти к содержимому</a><header class="header wrap"><a class="brand" href="/" aria-label="Best of Interiors — главная">best of<span>interiors<i>✳</i></span></a><nav aria-label="Главная навигация"><a href="/#categories">Все направления ↗</a><a href="/#method">Как выбираем</a></nav></header>
<main id="main" class="wrap"><section class="city-hero"><nav class="breadcrumbs" aria-label="Хлебные крошки"><a href="/">Главная</a><span>/</span><span>Дизайн интерьера</span></nav><span class="micro accent">ВАШ ГОРОД. ВАШИ ЛЮДИ.</span><h1>Студии дизайна интерьера.<br/><em>Ближе к вам.</em></h1><p>Выберите город, чтобы сравнить команды, цены и услуги. От первой планировки до дома, в котором всё по-вашему.</p><a class="r-button" href="#cities">Выбрать город ↓</a><img src="/images/moscow-portal-1200.webp" width="1200" height="800" alt=""/></section>
<section id="cities" class="city-section"><div class="rank-section-head"><div><span class="micro accent">РЕЙТИНГИ / 2026</span><h2>Где будет ваш дом?</h2></div><p>Сначала город.<br/>Затем — команда под вашу задачу.</p></div><div class="city-grid">{designCities.map((c,i)=><a class="city-card" href={c.url}><div class="city-card-top"><span class="micro">0{i+1} / {c.count} КОМПАНИЙ</span><span aria-hidden="true">↗</span></div><h3>{c.name}</h3><p>{c.description}</p><span class="city-card-bottom">Смотреть рейтинг <span aria-hidden="true">→</span></span></a>)}</div><p class="city-note">Добавляем новые города по мере подготовки рейтингов. Сейчас доступны {designCities.map(c=>c.name).join(', ')}.</p></section>
<section class="city-guide"><h2>Один город.<br/><em>Разные подходы.</em></h2><div><p>На странице города можно отфильтровать компании по бюджету, услугам и наличию офиса, сравнить до четырёх команд и изучить основания оценки.</p><p>Для квартиры, загородного дома и коммерческого пространства нужен разный опыт. Смотрите состав проекта, похожие работы и условия сопровождения — так проще найти подходящих людей.</p><a class="text-link" href="/#categories">Мебель, кухни, окна и другие направления ↗</a></div></section></main><footer class="footer wrap"><a href="/">← Best of Interiors</a><a href="/#method">Принципы оценки ↗</a><span>© 2026 Best of Interiors</span><ProjectCredit/></footer><Metrika/></body></html>
<style>
.city-hero{position:relative;isolation:isolate;overflow:hidden;padding:30px 0 90px;min-height:650px}.city-hero .micro{display:block;margin:62px 0 28px}.city-hero h1{font-size:clamp(42px,5.5vw,84px);line-height:1.08;letter-spacing:-.055em;max-width:1050px;margin-bottom:32px}.city-hero em,.city-guide em{font-family:Georgia,serif;font-weight:400;color:#adc1ff}.city-hero p{max-width:660px;color:#c7cbd5;font-size:23px;line-height:1.6;margin-bottom:32px}.city-hero img{position:absolute;z-index:-1;right:-24%;top:0;height:100%;width:90%;object-fit:cover;opacity:.32;mask-image:linear-gradient(90deg,transparent,#000 65%)}.city-section{padding:60px 0 100px;scroll-margin-top:30px}.city-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:24px}.city-card{display:flex;flex-direction:column;background:linear-gradient(135deg,#212733,#151719);border:1px solid #414958;border-radius:24px;padding:38px;transition:transform .2s,border-color .2s}.city-card:hover{transform:translateY(-5px);border-color:#a6bfff}.city-card:focus-visible{outline:3px solid #a6bfff;outline-offset:5px}.city-card-top,.city-card-bottom{display:flex;justify-content:space-between;align-items:center}.city-card-top>span:last-child{font-size:38px;color:#adc1ff}.city-card h3{font-size:clamp(34px,4vw,56px);letter-spacing:-.05em;margin:45px 0 22px}.city-card p{font-size:20px;color:#c7cbd5;line-height:1.6;max-width:450px;margin-bottom:38px}.city-card-bottom{border-top:1px solid #414958;padding-top:24px;margin-top:auto;font-size:19px;color:#adc1ff}.city-note{font-size:18px;line-height:1.6;color:#aab0ba;margin-top:28px}.city-guide{display:grid;grid-template-columns:1fr 1fr;gap:60px;padding:40px 0 100px}.city-guide h2{font-size:clamp(36px,4vw,58px);line-height:1.1;letter-spacing:-.04em}.city-guide p{font-size:21px;color:#c7cbd5;line-height:1.65;margin-bottom:24px}.breadcrumbs{flex-wrap:wrap}@media(max-width:700px){.city-grid,.city-guide{grid-template-columns:1fr}.city-card{padding:26px}.city-hero{min-height:auto;padding-bottom:50px}.city-hero p{font-size:20px}.city-guide{gap:30px}.city-hero h1{font-size:44px}.city-section{padding-top:30px}}@media(prefers-reduced-motion:reduce){.city-card{transition:none}}
</style>
