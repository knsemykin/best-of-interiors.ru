---
import '@fontsource-variable/manrope';
import { indexable } from '../../../../data/site';
import '../../../../styles/global.css';
import '../../../../styles/ranking.css';
import StudioCard from '../../../../components/StudioCard.astro';
import LeadDialog from '../../../../components/LeadDialog.astro';
import {residential,commercial,studios,criteria,price,path} from '../../../../data/moscow';
const canonical=`https://best-of-interiors.ru${path}`;
const title='Лучшие студии дизайна интерьера Москвы — рейтинг 2026';
const description='175 студий дизайна интерьера и бюро Москвы и МО: цены, услуги, контакты и источники. Фильтры, сравнение и прозрачная методика рейтинга. Данные на октябрь 2026.';
const promos=[{id:'MSK006',image:'hero',heading:'Интерьер, в котором узнаёте себя.',text:'Дизайн-проект под ваш образ жизни. Обсудите состав работ и сравните индивидуальный и эксклюзивный тарифы.'},{id:'MSK005',image:'moscow-living',heading:'Ваше пространство. Ваш характер.',text:'Знакомство со студией начинается с вашей задачи. Запросите подход к проекту, состав команды и примеры близких вам работ.'},{id:'MSK001',image:'kitchen',heading:'От архитектуры до ощущения дома.',text:'В материалах бюро — направления Nature, Accent и VIP. Авторское сопровождение и комплектация рассчитываются отдельно.'}];
const faq=[
 ['Какая студия дизайна интерьера в Москве лучшая?','Универсальной лучшей студии нет: для квартиры, дома и коммерческого помещения нужны разные компетенции. В нашем списке первое место среди жилых студий по раскрытым сведениям занимает VPROEKTE — 92,5 из 100. Это результат методики, а не гарантия качества ремонта. Сравните близкие вам проекты, состав услуг и условия договора.'],
 ['Что входит в стоимость дизайн-проекта?','Состав зависит от тарифа. Уточняйте обмеры, планировочные решения, визуализации, рабочие чертежи, спецификации и число правок. Авторское сопровождение, закупки и ремонт могут оплачиваться отдельно. В карточках мы показываем опубликованную ставку и её ограничения.'],
 ['Чем студия дизайна отличается от бюро интерьера?','Название само по себе не определяет состав услуг. Бюро может заниматься архитектурой, общественными пространствами или частными интерьерами; студия — вести проект целиком либо только разрабатывать документацию. Сравнивайте задачи, команду и договор, а не вывеску.'],
 ['Почему у нескольких студий одинаковое место?','Одинаковый индекс означает одинаковое место. Внутри группы компании расположены по алфавиту. Например, после нескольких участников на втором месте следующее место может быть девятым. Сортировка по цене не меняет исходный балл или место.'],
 ['Вы проверяли отзывы и качество выполненного ремонта?','Нет. Этот выпуск основан на открытых материалах компаний из предоставленного исследовательского набора. Мы не проводили независимую проверку качества объектов, отзывов, юридических лиц, офиса или телефонных номеров. Заявления о реализованных проектах дают только частичный балл.'],
 ['Можно ли купить место или изменить оценку?','Размещение в ПРОМО не влияет на индекс. Новые документы, ссылки на цены и сведения об услугах могут стать основанием для обновления данных и пересчёта по тем же весам. Отсутствие сведений не означает, что компания плохая.'],
 ['В списке только студии с московским офисом?','Нет. Есть команды с заявленным офисом в Москве и области, а также бюро, публикующие проекты или услуги в регионе. Используйте фильтр офиса и смотрите основание присутствия в карточке.'],
 ['Как работает одна заявка нескольким студиям?','Вы один раз описываете пространство, бюджет и пожелания. В рабочей версии запрос будет передаваться указанным получателям после вашего согласия; участие и ответ каждой студии не гарантируются. Сейчас можно пройти квиз и проверить заполнение, но отправка отключена.'],
];
const schema={'@context':'https://schema.org','@graph':[
 {'@type':'Organization','@id':'https://best-of-interiors.ru/#organization',name:'Best of Interiors',url:'https://best-of-interiors.ru/'},
 {'@type':'CollectionPage','@id':canonical+'#page',url:canonical,name:title,description,inLanguage:'ru-RU',dateModified:'2026-10-09',author:{'@id':'https://best-of-interiors.ru/#organization'},mainEntity:[{'@id':canonical+'#home-list'},{'@id':canonical+'#business-list'}]},
 {'@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:'Главная',item:'https://best-of-interiors.ru/'},{'@type':'ListItem',position:2,name:'Студии дизайна интерьера Москвы',item:canonical}]},
 ...[residential,commercial].map((list,i)=>({'@type':'ItemList','@id':canonical+(i?'#business-list':'#home-list'),name:i?'Коммерческие и архитектурные бюро':'Студии жилых интерьеров Москвы и МО',numberOfItems:list.length,itemListOrder:'https://schema.org/ItemListOrderDescending',itemListElement:list.map((s,position)=>({'@type':'ListItem',position:position+1,name:s.name,url:canonical+'#'+s.studio_id}))}))]};
---
<!doctype html><html lang="ru"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="theme-color" content="#101112"/><meta name="format-detection" content="telephone=no,email=no,address=no"/><title>{title} | Best of Interiors</title><meta name="description" content={description}/><meta name="robots" content={indexable ? "index, follow, max-image-preview:large" : "noindex, follow"}/><link rel="canonical" href={canonical}/><link rel="icon" href="/favicon.svg"/><meta property="og:type" content="website"/><meta property="og:locale" content="ru_RU"/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/><meta property="og:image" content="https://best-of-interiors.ru/images/moscow-portal-1200.webp"/><meta property="og:image:alt" content="Архитектурная арка — концептуальная иллюстрация Best of Interiors"/><meta name="twitter:card" content="summary_large_image"/><script type="application/ld+json" set:html={JSON.stringify(schema)}/></head>
<body class="ranking-page"><a class="skip" href="#main">Перейти к содержимому</a><header class="header wrap"><a class="brand" href="/" aria-label="Best of Interiors — главная">best of<span>interiors<i>✳</i></span></a><nav aria-label="Главная навигация"><a href="#rating">Рейтинг ↗</a><a href="#methodology">Как считаем</a><a href="#guide">Как выбрать</a></nav><button class="header-cta" data-quiz>Один бриф — больше выбора ↗</button></header>
<main id="main"><section class="rank-hero wrap"><img class="rank-art" src="/images/moscow-portal-1800.webp" srcset="/images/moscow-portal-640.webp 640w, /images/moscow-portal-1200.webp 1200w, /images/moscow-portal-1800.webp 1800w" sizes="100vw" width="1536" height="1024" fetchpriority="high" alt=""/><nav class="breadcrumbs" aria-label="Хлебные крошки"><a href="/">Главная</a><span>/</span><span>Дизайн интерьера · Москва и МО</span></nav><div class="hero-edition"><span class="micro"><span class="dot"></span> МОСКВА И МОСКОВСКАЯ ОБЛАСТЬ</span><span class="micro">ОКТЯБРЬ / 2026</span></div><h1>Лучшие студии<br/>дизайна интерьера<br/><em>Москвы</em><span class="h1-edition">Рейтинг 2026</span></h1><p class="rank-hero-intro">Ваш дом — слишком личное,<br/>чтобы выбирать наугад.</p><p class="rank-hero-copy">Сравните студии, цены и подход к работе.<br/>Найдите людей, с которыми вам по пути.</p><div class="hero-links"><a href="#rating" class="r-button">Найти свою студию <span>↗</span></a><button class="r-secondary" data-quiz>Описать проект один раз</button></div><button class="rank-motion" aria-label="Приостановить анимацию" aria-pressed="false">Ⅱ</button><div class="hero-data"><span><b>175</b> студий и бюро</span><span><b>10</b> критериев</span><span><b>0</b> платных баллов</span><a href="#editorial">Данные на 09.10.2026 ↗</a></div></section>
<nav class="rank-nav wrap" aria-label="Разделы рейтинга"><a href="#promotions">Промо</a><a href="#rating">Студии <span>175</span></a><a href="#methodology">Методика</a><a href="#prices">Цены</a><a href="#guide">Как выбрать</a><a href="#questions">Вопросы</a></nav>
<section class="trust-intro wrap"><span class="micro accent">СНАЧАЛА — ВАЖНОЕ</span><p>Здесь оцениваем <strong>открытость сведений</strong>, а не обещаем идеальный ремонт. У каждого балла есть основание. У каждого промо — своя пометка.</p><a href="#methodology">Как читать рейтинг ↗</a></section>
<section id="promotions" class="rank-section wrap"><div class="rank-section-head"><div><span class="micro accent">01 / ЗНАКОМСТВО КРУПНЫМ ПЛАНОМ</span><h2>Возможно, ваши люди.</h2></div><p>ПРОМО — отдельные размещения.<br/>На места в рейтинге не влияют.</p></div><div class="promo-grid">{promos.map((p,i)=>{const s=studios.find(s=>s.studio_id===p.id)!;return <article class={`featured featured-${i}`}><div class="featured-image"><img loading="lazy" src={`/images/${p.image}-640.webp`} width="640" height="427" alt="AI-концепт интерьера для оформления, не работа студии"/><span class="promo-badge">ПРОМО</span><span class="concept-label">AI-КОНЦЕПТ · НЕ РАБОТА СТУДИИ</span></div><div class="featured-body"><span class="micro">{s.name}</span><h3>{p.heading}</h3><p>{p.text}</p><div class="featured-bottom"><span>{price(s)}</span><button class="r-button" data-lead={s.studio_id}>Обсудить свой проект ↗</button><a href={`#${s.studio_id}`}>Данные студии в рейтинге ↗</a></div></div></article>})}</div><p class="r-note promo-preview">Предпросмотр рекламных мест. Компании выбраны для макета; оплаченные размещения не заявляются. Иллюстрации созданы ИИ и не являются портфолио компаний.</p></section>
<section id="rating" class="rank-section wrap"><div class="rank-section-head"><div><span class="micro accent">02 / БОЛЬШЕ ЯСНОСТИ. МЕНЬШЕ СЛУЧАЙНОСТЕЙ.</span><h2>Найдите свою<br/><em>студию.</em></h2></div><p>Начните с того, что важно вам.<br/>Сохраните до четырёх студий для сравнения.</p></div><div class="directory-layout"><aside class="filters" aria-label="Фильтры студий"><form id="filters" role="search"><h3>Ваши ориентиры</h3><label>Поиск<input type="search" id="search" placeholder="Студия, стиль или ЖК" autocomplete="off"/></label><label>Тип проекта<select id="segment"><option value="home">Жилые интерьеры · 164</option><option value="business">Бизнес и архитектура · 11</option><option value="all">Все направления · 175</option></select></label><label>Дизайн-проект, ₽/м²<select id="budget"><option value="all">Любой бюджет</option><option value="3000">До 3 000 ₽/м²</option><option value="5000">До 5 000 ₽/м²</option><option value="10000">До 10 000 ₽/м²</option><option value="known">С опубликованной ценой в ₽</option><option value="unknown">Без сопоставимой цены в ₽</option></select></label><label>Расположение<select id="office"><option value="all">Москва и МО · все команды</option><option value="local">Заявлен офис в Москве / МО</option><option value="other">Иное основание присутствия</option></select></label><fieldset><legend>Нужные услуги</legend><label class="check"><input type="checkbox" id="supervision"/>Авторское сопровождение</label><label class="check"><input type="checkbox" id="procurement"/>Комплектация</label><label class="check"><input type="checkbox" id="renovation"/>Ремонт / реализация</label></fieldset><p class="r-note">Фильтры услуг основаны на заявлениях студий. Цена «от» не равна итоговой смете.</p><button type="reset" class="reset-filters">Сбросить фильтры ↺</button></form><a class="filter-method" href="#methodology">Что означает индекс?<span>Баллы за раскрытые сведения,<br/>не за красивые обещания. ↗</span></a></aside><div class="directory"><div class="directory-toolbar"><p id="result-count" role="status" aria-live="polite">175 студий и бюро</p><label>Порядок<select id="sort"><option value="score">По индексу сведений</option><option value="price">Сначала доступнее</option><option value="name">По названию</option></select></label></div><p class="directory-note">Сведения собраны 9 октября 2026. Все компании оцениваются по одной формуле внутри своего сегмента. ПРОМО в расчёт не входит.</p><noscript><p class="preview-notice">Без JavaScript показаны все 175 компаний. Для поиска используйте поиск браузера; формы и фильтры требуют JavaScript.</p></noscript><div id="studio-list">{[...residential,...commercial].map(s=><StudioCard studio={s}/>)}</div><div id="empty-state" class="empty-state" hidden><h3>Попробуем чуть шире?</h3><p>По этим условиям студий не нашлось. Уберите один из фильтров или измените запрос.</p><button class="r-button" id="empty-reset">Сбросить фильтры</button></div><nav class="pagination" id="pagination" hidden aria-label="Страницы списка"><button id="page-prev" class="r-secondary">← Назад</button><span id="page-status" aria-live="polite"></span><button id="page-next" class="r-secondary">Далее →</button></nav><button id="show-all" class="reset-filters" hidden>Показать все результаты на одной странице</button></div></div></section>
<section id="methodology" class="rank-section method-section"><div class="wrap"><div class="rank-section-head"><div><span class="micro accent">03 / ДОВЕРИЕ НАЧИНАЕТСЯ С ПРОЗРАЧНОСТИ</span><h2>Никакой магии.<br/><em>Только основания.</em></h2></div><p>Индекс раскрытых сведений.<br/>Версия методики: Москва / 1.0.</p></div><div class="method-intro"><p>Из 255 изученных сайтов в набор вошли 175 компаний: 164 студии жилых интерьеров и 11 коммерческих или архитектурных бюро. Это исследовательская выборка, а не полный реестр рынка.</p><p>Алгоритм складывает баллы по десяти критериям. Если сведений нет — критерий получает 0. Поэтому индекс может быть выше у компании с более подробным сайтом, даже если другая команда работает не хуже.</p></div><div class="weight-grid">{criteria.map(([name,weight,explanation],i)=><details><summary><span class="micro">{String(i+1).padStart(2,'0')}</span><h3>{name}</h3><b>{weight}<small>баллов</small></b></summary><p>{explanation} При отсутствии подтверждающих сведений в наборе — 0.</p></details>)}</div><div class="method-foot"><div><h3>Формула открыта</h3><p>Индекс = сумма «вес × коэффициент». Коэффициенты — от 0 до 1. Место = 1 + число компаний сегмента с большим баллом. При равенстве баллов место одинаковое; порядок — по алфавиту.</p></div><div><h3>Что мы не утверждаем</h3><p>Не оценивали отзывы, финансовую устойчивость и удовлетворённость клиентов. Офисы не посещали. Факт сдачи проектов не подтверждали независимо. Этот индекс не является пользовательским рейтингом со звёздами.</p></div><div><h3>Можно дополнить данные</h3><p>Новые подтверждения могут изменить баллы. Для пересчёта нужны ссылки на сведения и дата их публикации. ИИ может помогать сопоставлять материалы; в этом выпуске публикуется воспроизводимый расчёт по исследовательскому набору.</p></div></div></div></section>
<section id="prices" class="rank-section wrap"><div class="rank-section-head"><div><span class="micro accent">04 / БЮДЖЕТ БЕЗ НЕДОСКАЗАННОСТИ</span><h2>Сколько стоит<br/>дизайн интерьера в Москве?</h2></div><p>Сравнивайте одинаковый состав.<br/>Иначе цена за метр мало что говорит.</p></div><div class="price-guide"><article><span class="micro">ДИЗАЙН-ПРОЕКТ</span><h3>Платите за состав,<br/>а не за название тарифа.</h3><p>В карточках — опубликованные ставки полного проекта, где их удалось выделить. Минимальная площадь, количество визуализаций и правок могут менять итоговую стоимость.</p></article><article><span class="micro">СОПРОВОЖДЕНИЕ</span><h3>Чертёж и стройка —<br/>разные задачи.</h3><p>Уточните частоту выездов, участие в общении с подрядчиками и стоимость дополнительных встреч. Авторское сопровождение само по себе не означает выполнение ремонта.</p></article><article><span class="micro">КОМПЛЕКТАЦИЯ</span><h3>Подобрать —<br/>не всегда закупить.</h3><p>Спецификации, заказ мебели, логистика и приёмка — разные услуги. Спросите, что входит в тариф и оплачивается ли работа фиксированно или процентом от закупок.</p></article></div><div class="calculator"><div><h3>Прикиньте бюджет проекта</h3><p>Площадь × ставка. Без ремонта, мебели и отдельных услуг.</p></div><label>Площадь, м²<input id="calc-area" type="number" min="10" max="100000" value="80"/></label><label>Ставка, ₽/м²<input id="calc-rate" type="number" min="100" max="1000000" value="5000"/></label><output id="calc-result" aria-live="polite">400 000 ₽</output><p class="r-note">Это арифметический ориентир, не средняя цена рынка и не коммерческое предложение.</p></div></section>
<section id="guide" class="rank-section wrap guide-layout"><div><span class="micro accent">05 / ВЫБИРАЙТЕ СПОКОЙНО</span><h2>Красивое портфолио —<br/><em>начало разговора.</em></h2><p>Чтобы выбрать студию дизайна интерьера в Москве, полезно обсудить с несколькими командами одну и ту же задачу.</p><button class="r-button" data-quiz>Составить общий бриф ↗</button></div><ol class="selection-steps"><li><span>01</span><div><h3>Покажите свою жизнь</h3><p>Кто будет жить дома, как проходит день, что раздражает сейчас? Эти ответы важнее списка модных стилей.</p></div></li><li><span>02</span><div><h3>Попросите похожие реализации</h3><p>Ищите близкие площадь, бюджет и тип объекта. Уточните, где фотография результата, а где визуализация.</p></div></li><li><span>03</span><div><h3>Сравните предложения по строкам</h3><p>Чертежи, сроки, правки, сопровождение, закупки и порядок оплаты. Попросите отдельно указать исключения.</p></div></li><li><span>04</span><div><h3>Познакомьтесь с вашей командой</h3><p>Кто будет вести проект каждый день? Кто принимает решения и помогает, если стройка идёт не по плану?</p></div></li></ol></section>
