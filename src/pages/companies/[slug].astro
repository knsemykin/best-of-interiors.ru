---
import Metrika from "../../components/Metrika.astro";
import '@fontsource-variable/manrope';
import '../../styles/global.css';
import '../../styles/ranking.css';
import allPortfolios from '../../data/promo-portfolios.json';
const portfolios = allPortfolios.filter(p=>p.id==='MSK006');
import {studios,price,path} from '../../data/moscow';
import {indexable} from '../../data/site';
import LeadDialog from '../../components/LeadDialog.astro';
export function getStaticPaths(){return allPortfolios.filter(p=>p.id==='MSK006').map(p=>({params:{slug:p.slug},props:{portfolio:p}}));}
const {portfolio:p}=Astro.props;const s=studios.find(s=>s.studio_id===p.id)!;
const canonical=`https://best-of-interiors.ru/companies/${p.slug}/`;
---
<!doctype html><html lang="ru"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>{p.name} — портфолио, цены и контакты | Best of Interiors</title><meta name="description" content={`Портфолио ${p.name}: ${p.works.length} проектов, услуги, цены и контакты студии. Материалы из официального портфолио.`}/><meta name="robots" content={indexable ? "index, follow, max-image-preview:large" : "noindex, follow"}/><link rel="canonical" href={canonical}/><meta name="format-detection" content="telephone=no,email=no,address=no"/><link rel="icon" href="/favicon.svg"/></head><body class="ranking-page company-page"><header class="header wrap"><a class="brand" href="/">best of<span>interiors<i>✳</i></span></a><a href="/ratings/dizayn-interera/">← Рейтинги по городам</a></header><main class="wrap"><nav class="breadcrumbs"><a href="/">Главная</a> / <a href="/ratings/dizayn-interera/">Дизайн интерьера</a> / <span>{p.name}</span></nav><section class="company-intro"><span class="promo-badge">ПРОМО · РАСШИРЕННАЯ КАРТОЧКА</span><h1>{p.name}</h1><p>{s.usp_declared?.startsWith('Отдельное отличие')?s.services:s.usp_declared}</p><div class="company-price"><strong>{price(s)}</strong><button class="r-button" data-company-lead>Получить персональное предложение ↗</button></div><p class="r-note">Стоимость зависит от площади и состава проекта.</p>{s.yandex_rating&&<a class="yandex-rating" href={s.yandex_url} target="_blank" rel="noopener noreferrer">Яндекс: 5,0 · 43 оценки · 09.10.2026 ↗</a>}</section><section id="portfolio" class="company-portfolio"><div class="rank-section-head"><div><span class="micro accent">ПРОСТРАНСТВА СО СВОИМ ХАРАКТЕРОМ</span><h2>Портфолио {p.name}</h2></div><p>Фотографии и визуализации из официальных материалов студии.</p></div><div class="company-work-grid">{p.works.map(w=><figure><img src={w.image} loading="lazy" width="1200" height="800" alt={`${w.title}, портфолио ${p.name}`}/><figcaption><h3>{w.title}</h3><p>{'subtitle'in w?w.subtitle:'Проект из портфолио студии'}</p><a href={w.source} target="_blank" rel="noopener noreferrer">Источник и сведения о проекте ↗</a></figcaption></figure>)}</div></section><section class="company-contacts"><h2>Знакомство начинается<br/>с вашей задачи.</h2><dl class="contact-list"><div><dt>Сайт</dt><dd>{s.website}</dd></div><div><dt>Телефон</dt><dd>{s.phone}</dd></div><div><dt>Офис по данным студии</dt><dd>{s.office_address||'Уточните при знакомстве'}</dd></div><div><dt>Стили</dt><dd>{s.styles_mentioned}</dd></div></dl><button class="r-button" data-company-lead>Обсудить проект со студией ↗</button></section></main><footer class="footer wrap"><a href="/ratings/dizayn-interera/">← Студии по городам</a><span>© 2026 Best of Interiors</span></footer><LeadDialog/><script define:vars={{name:p.name,id:p.id}}>const dialog=document.querySelector('#lead-dialog');const form=document.querySelector('#lead-form');document.querySelectorAll('[data-company-lead]').forEach(b=>b.addEventListener('click',()=>{form.reset();form.hidden=false;document.querySelector('#lead-result').hidden=true;document.querySelector('#lead-title').textContent='Познакомимся поближе?';document.querySelector('#lead-recipient').textContent='Персональное предложение от '+name;document.querySelector('#lead-studio').value=id;dialog.showModal();}));dialog.querySelectorAll('[data-close]').forEach(b=>b.addEventListener('click',()=>dialog.close()));dialog.addEventListener('close',()=>form.reset());form.addEventListener('submit',e=>{e.preventDefault();const phone=form.elements.phone.value;if(phone.replace(/\D/g,'').length<7||!/^[-+0-9()\s]+$/.test(phone)){document.querySelector('#form-error').textContent='Укажите корректный телефон.';return;}document.querySelector('#form-error').textContent='';form.dispatchEvent(new CustomEvent('lead:submit',{detail:{selected:[]}}));});</script><Metrika/></body></html>
