---
import '@fontsource-variable/manrope';
import '../styles/global.css';
import '../styles/ranking.css';
import '../styles/partners.css';
import Metrika from '../components/Metrika.astro';
import EditorialDialog from '../components/EditorialDialog.astro';
import {indexable} from '../data/site';
const title='Продвижение студии дизайна интерьера — партнёрство с Best of Interiors';
const description='ПРОМО перед рейтингом, расширенная карточка, редакционные материалы и заявки с подробным брифом. Москва от 20 000 ₽/мес., другие миллионники от 5 000 ₽/мес.';
const cities=['Санкт-Петербург','Новосибирск','Екатеринбург','Казань','Красноярск','Нижний Новгород','Челябинск','Уфа','Самара','Ростов-на-Дону','Краснодар','Омск','Воронеж','Пермь','Волгоград'];
const faq=[
 ['Что входит в размещение?','Позиция в ПРОМО выбранного города, расширенная карточка компании, размещения в карточках других студий и три партнёрских материала в согласованном пакете. Сроки статей, площадки вставок и период размещения закрепляем в договоре.'],
 ['Как оплачиваются заявки?','Отдельно от размещения: 1 500 ₽ за полученную заявку. Подключение — по договору через ЭДО. Критерии подходящей заявки, дубли, спорные обращения, лимит и порядок оплаты согласуем до старта.'],
 ['Кому клиент разрешает передать заявку?','Сначала заявка поступает Best of Interiors. Затем — студиям, которых выбрал клиент, либо подходящим командам по его согласию на подбор редакцией. Партнёрство не даёт доступа к обращениям, адресованным другим студиям.'],
 ['Как работают 30 минут приоритета?','После проверки брифа редакция передаёт его подходящим партнёрам, которым клиент разрешил направить запрос. Остальные допустимые получатели получают его через 30 минут. Это время для первого контакта и подготовки ответа; услугу подключаем по договору.'],
 ['Повлияет ли партнёрство на основной рейтинг?','Расширенная карточка помогает раскрыть опыт компании. Новые сведения и подтверждения могут изменить оценку по общей методике. Оплата размещения сама по себе не добавляет баллы и не гарантирует позицию в основном рейтинге.'],
 ['Можно разместиться по всей России?','Можно выбрать несколько городов. Стоимость складывается из тарифов каждого города. Москва и МО считаются одним размещением; каждый другой миллионник — отдельным. Запуск и наличие рейтинга в нужном городе согласуем до оплаты.'],
 ['Гарантируете ли вы клиентов?','Нет. Результат зависит от спроса, портфолио, цены, скорости ответа и работы отдела продаж. Мы согласуем размещения и порядок передачи заявок, но не обещаем конкретное число договоров с клиентами.']
];
const schema={'@context':'https://schema.org','@type':'WebPage',name:title,description,url:'https://best-of-interiors.ru/partners/',inLanguage:'ru-RU'};
---
<!doctype html><html lang="ru"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>{title}</title><meta name="description" content={description}/><meta name="robots" content={indexable?'index, follow, max-image-preview:large':'noindex, follow'}/><link rel="canonical" href="https://best-of-interiors.ru/partners/"/><link rel="icon" href="/favicon.svg"/><meta name="theme-color" content="#101112"/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:type" content="website"/><meta property="og:url" content="https://best-of-interiors.ru/partners/"/><meta property="og:image" content="https://best-of-interiors.ru/images/partner-placements.webp"/><script type="application/ld+json" set:html={JSON.stringify(schema)}/></head>
<body class="ranking-page partners"><a class="skip" href="#main">Перейти к содержимому</a><header class="header wrap"><a class="brand" href="/" aria-label="Best of Interiors — главная">best of<span>interiors<i>✳</i></span></a><nav aria-label="Навигация"><a href="#formats">Возможности</a><a href="#prices">Тарифы</a><a href="#contact">Стать партнёром ↗</a></nav></header>
<main id="main">
<section class="partner-hero wrap"><div class="partner-intro"><span class="micro accent">BEST OF INTERIORS / ДЛЯ БИЗНЕСА</span><h1>Ваши проекты<br/>заслуживают<br/><em>первого внимания.</em></h1><p>Продвижение студии дизайна интерьера там, где люди уже выбирают команду для своего дома.</p><div class="partner-actions"><a class="r-button" href="#prices">Выбрать размещение ↗</a><button class="text-link" data-cooperation>Обсудить задачу</button></div></div><figure><img src="/images/partner-placements.webp" width="1440" height="960" alt="Иллюстрация трёх заметных ПРОМО-позиций перед рейтингом" fetchpriority="high"/><figcaption>ТРИ ПРОМО-ПОЗИЦИИ. ОДНА ВОЗМОЖНОСТЬ БЫТЬ ЗАМЕЧЕННЫМ.</figcaption></figure></section>
<div class="partner-strip wrap"><span><b>01—03</b> места перед рейтингом</span><span><b>30 минут</b> приоритета по заявкам</span><span><b>3 материала</b> с нашей редакцией</span></div>
<section id="formats" class="partner-section wrap"><div class="partner-heading"><span class="micro accent">01 / ВНИМАНИЕ → ЗНАКОМСТВО → ДИАЛОГ</span><h2>Больше, чем<br/><em>строка в списке.</em></h2><p>Помогите будущему клиенту увидеть ваш подход, узнать людей за проектами и сделать первый шаг.</p></div>
<div class="placement-layout"><div><span class="partner-chip">ПРОМО ПЕРЕД ОСНОВНЫМ РЕЙТИНГОМ</span><h3>Знакомство начинается<br/>с верхней части страницы.</h3><p>Пока посетитель ещё не ушёл в длинный список, ваша студия уже перед ним: крупная подача, работы и приглашение обсудить проект.</p><p>В каждом городе — до трёх ПРОМО-позиций. Вы выбираете место и географию, мы готовим подачу в дизайне проекта.</p><a class="text-link" href="/ratings/dizayn-interera/moskva/#promotions">Посмотреть формат в рейтинге ↗</a></div><div class="placement-demo" aria-label="Схема рекламных размещений"><div><b>01</b><span>Первое знакомство<small>ПРОМО / Позиция 1</small></span><i>↗</i></div><div><b>02</b><span>Ещё один сильный выбор<small>ПРОМО / Позиция 2</small></span><i>↗</i></div><div><b>03</b><span>Ваша команда рядом<small>ПРОМО / Позиция 3</small></span><i>↗</i></div><p>Далее — основной рейтинг компаний</p></div></div>
<div class="partner-story"><img src="/images/partner-story.webp" width="1200" height="800" loading="lazy" alt="Иллюстрация расширенного портфолио и получаса для первого ответа"/><div><span class="micro accent">ПОКАЖИТЕ, КТО ВЫ</span><h3>Не только название.<br/><em>История вашей команды.</em></h3><p>В расширенной карточке клиент видит, как вы думаете, проектируете и доводите идею до реализации.</p><ul><li>Кейсы, фотографии и портфолио</li><li>Сравнения проекта и реализации, «до / после»</li><li>Видеотуры и рассказы о проектах</li><li>Основатель, команда и офис</li><li>Подробные услуги, подход и условия работы</li></ul><a class="text-link" href="/companies/alina-salomatina/">Посмотреть расширенную карточку ↗</a></div></div>
<div class="partner-compare"><div><span class="micro">БАЗОВОЕ ПРЕДСТАВЛЕНИЕ</span><h3>Быстро познакомиться</h3><p>Название, краткое описание, услуги и контакты. Адрес сайта обычно показан текстом; у первых десяти компаний рейтинга ссылка активна.</p></div><div><span class="micro accent">ПАРТНЁРСКИЙ ПРОФИЛЬ</span><h3>Выбрать осознанно</h3><p>Полноценная страница с работами, видео и командой. Больше информации для клиента и больше подтверждений для оценки по методике проекта.</p></div></div>
<div class="partner-benefits"><article><span>↗</span><h3>Нужные города</h3><p>Работаете локально или по России? Выберите города, в которых готовы вести проекты. Каждое размещение рассчитывается отдельно.</p></article><article><span>✳</span><h3>Рядом с выбором</h3><p>ПРОМО вашей студии в карточках других компаний: дополнительная встреча с человеком, который сравнивает подходы.</p></article><article><span>＋</span><h3>Ваш опыт — в статьях</h3><p>Три партнёрских материала вместе с редакцией. Отвечаем на вопросы будущих клиентов, показываем экспертизу и даём повод узнать студию.</p></article></div></section>
<section class="priority-section"><div class="wrap"><span class="micro accent">02 / НАЧНИТЕ РАЗГОВОР РАНЬШЕ</span><div class="priority-heading"><h2>Хороший бриф.<br/><em>Ваши первые 30 минут.</em></h2><p>Клиент один раз описывает проект, бюджет и пожелания. Вы получаете контекст для предметного ответа, а не только номер телефона.</p></div><ol class="priority-flow"><li><b>01</b><h3>Клиент выбирает</h3><p>Конкретные студии или подбор редакцией. Согласие определяет круг получателей.</p></li><li><b>02</b><h3>Редакция направляет</h3><p>Подходящие партнёры из этого круга получают бриф первыми.</p></li><li><b>+30 мин</b><h3>Подключаются остальные</h3><p>Заявку получают другие студии, которым клиент разрешил её передать.</p></li></ol><div class="lead-price"><p><strong>1 500 ₽</strong> за полученную заявку</p><p>Подключение по договору через ЭДО.<br/>Оплачивается отдельно от размещения.</p><button class="r-button" data-cooperation data-plan="Хочу подключить заявки по 1 500 ₽. Обсудим условия и договор через ЭДО.">Обсудить заявки ↗</button></div></div></section>
<section id="prices" class="partner-section wrap"><div class="partner-heading"><span class="micro accent">03 / ПОНЯТНАЯ СТОИМОСТЬ</span><h2>Выберите место.<br/><em>И масштаб.</em></h2><p>Одинаковое наполнение пакета. Разная позиция в ПРОМО и стоимость города.</p></div><div class="price-switch" role="group" aria-label="Регион тарифа"><button type="button" data-market="moscow" aria-pressed="true">Москва и МО</button><button type="button" data-market="million" aria-pressed="false">Другие миллионники</button></div><p id="price-region" class="price-caption">Размещение в рейтинге Москвы и Московской области</p><div class="price-grid">{[1,2,3].map((place,i)=><article class:list={['price-card',{'price-first':place===1}]}><span class="micro">ПРОМО / ПОЗИЦИЯ {place}</span><h3>{place}-е место <span aria-hidden="true">↗</span></h3><p class="price-value"><strong data-price={i}>{[30000,25000,20000][i].toLocaleString('ru-RU')}</strong> ₽<small>в месяц / один город</small></p><ul><li>Место перед основным рейтингом</li><li>Расширенная карточка компании</li><li>ПРОМО в карточках других студий</li><li>3 партнёрских материала в пакете</li><li>30 минут приоритета при подключении заявок</li></ul><button class="r-button" data-cooperation data-place={place} data-plan={`Интересует ПРОМО: ${place}-е место, Москва и МО. Хочу уточнить наличие и условия.`}>Обсудить {place}-е место ↗</button></article>)}</div><p class="partner-note">Заявки не включены: +1 500 ₽ за полученную заявку, если подключили услугу. Свободные места, даты выхода трёх материалов и условия размещения фиксируем в договоре.</p>
<div class="geo-calculator"><div><span class="micro accent">НЕСКОЛЬКО ГОРОДОВ</span><h3>Соберите свою<br/>географию.</h3><p>Москва и МО — по столичному тарифу. Каждый другой миллионник — по региональному. Для других городов подготовим предложение.</p><p class="partner-note">Сейчас опубликованы Москва и Воронеж. Остальные города — по согласованию запуска рейтинга; выбор здесь не бронирует место.</p></div><div class="geo-controls"><label>ПРОМО-позиция<select id="geo-position"><option value="0">1-е место</option><option value="1">2-е место</option><option value="2">3-е место</option></select></label><label class="geo-check"><input id="geo-moscow" type="checkbox" checked/> Москва и Московская область</label><fieldset><legend>Другие города-миллионники</legend><div class="geo-cities">{cities.map(city=><label><input type="checkbox" name="partner-city" value={city}/>{city}</label>)}</div></fieldset><div class="geo-total" aria-live="polite"><span>Размещение в месяц</span><strong id="geo-total">30 000 ₽</strong></div><p class="partner-note">Без стоимости заявок. Выберите хотя бы один город.</p><button id="geo-request" class="r-button" data-cooperation data-plan="Интересует ПРОМО: 1-е место, Москва и МО. Размещение 30 000 ₽/мес. без заявок.">Обсудить мой план ↗</button></div></div></section>
<section class="partner-section partner-economics wrap"><span class="micro accent">04 / СЧИТАЕМ ВМЕСТЕ</span><h2>Один новый проект<br/><em>может изменить экономику.</em></h2><div><p>Например, третье ПРОМО-место в городе-миллионнике стоит 60 000 ₽ за 12 месяцев. Если прибыль от привлечённого проекта выше этой суммы и расходов на заявки, один договор может окупить год размещения.</p><p>Это пример расчёта, не обещание результата. Оценивать отдачу стоит по вашей марже, стоимости заявок и конверсии в договор. Заметность помогает начать знакомство; убедительное портфолио и быстрый ответ помогают его продолжить.</p></div></section>
<section class="partner-section wrap"><div class="partner-heading"><span class="micro accent">05 / ДО СТАРТА</span><h2>Сначала договоримся.<br/><em>Потом запускаем.</em></h2></div><div class="partner-benefits"><article><span>01</span><h3>Знакомимся</h3><p>Расскажите о компании, городах и клиентах, с которыми хотите работать. Проверим свободные позиции.</p></article><article><span>02</span><h3>Фиксируем условия</h3><p>Согласуем пакет, материалы, график и бюджет. Для получения заявок заключаем договор через ЭДО.</p></article><article><span>03</span><h3>Готовим подачу</h3><p>Собираем портфолио, команду и описание. Утверждаем карточку и начинаем размещение.</p></article></div><div class="partner-faq">{faq.map(([q,a])=><details><summary>{q}<span aria-hidden="true">＋</span></summary><p>{a}</p></details>)}</div></section>
<section id="contact" class="partner-contact wrap"><span class="micro">ДАВАЙТЕ ЗНАКОМИТЬ ВАС С ВАШИМИ КЛИЕНТАМИ</span><h2>Хорошая студия.<br/><em>Заметная история.</em></h2><button class="r-button" data-cooperation>Обсудить сотрудничество ↗</button><a href="mailto:hello@best-of-interiors.ru">hello@best-of-interiors.ru</a></section>
</main><footer class="footer wrap"><a href="/">← Best of Interiors</a><a href="/ratings/dizayn-interera/">Рейтинги по городам</a><a href="/privacy/">Конфиденциальность</a><span>© 2026 Best of Interiors</span></footer><EditorialDialog/><Metrika/>
<script>
const prices={moscow:[30000,25000,20000],million:[15000,10000,5000]};const fmt=(n:number)=>n.toLocaleString('ru-RU');
document.querySelectorAll<HTMLButtonElement>('[data-market]').forEach(button=>button.addEventListener('click',()=>{const market=button.dataset.market as keyof typeof prices;document.querySelectorAll('[data-market]').forEach(b=>b.setAttribute('aria-pressed',String(b===button)));document.querySelectorAll<HTMLElement>('[data-price]').forEach((el,i)=>el.textContent=fmt(prices[market][i]));const region=market==='moscow'?'Москва и МО':'другой город-миллионник';document.querySelector('#price-region')!.textContent=market==='moscow'?'Размещение в рейтинге Москвы и Московской области':'Стоимость за каждый город-миллионник, кроме Москвы';document.querySelectorAll<HTMLButtonElement>('[data-place]').forEach(b=>b.dataset.plan=`Интересует ПРОМО: ${b.dataset.place}-е место, ${region}. Хочу уточнить наличие и условия.`);}));
const position=document.querySelector<HTMLSelectElement>('#geo-position')!,moscow=document.querySelector<HTMLInputElement>('#geo-moscow')!,request=document.querySelector<HTMLButtonElement>('#geo-request')!;
function calculate(){const i=Number(position.value),selected=Array.from(document.querySelectorAll<HTMLInputElement>('[name="partner-city"]:checked')).map(x=>x.value);const total=(moscow.checked?prices.moscow[i]:0)+selected.length*prices.million[i];document.querySelector('#geo-total')!.textContent=fmt(total)+' ₽';request.disabled=total===0;request.dataset.plan=`Интересует ПРОМО: ${i+1}-е место. Города: ${[...(moscow.checked?['Москва и МО']:[]),...selected].join(', ')}. Размещение ${fmt(total)} ₽/мес. без заявок. Уточните доступность и сроки запуска.`;}
document.querySelectorAll('.geo-controls input,.geo-controls select').forEach(el=>el.addEventListener('change',calculate));
</script></body></html>
